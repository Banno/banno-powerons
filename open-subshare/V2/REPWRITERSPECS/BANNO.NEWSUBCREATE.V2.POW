PROCEDURE BUILDSERVICEARRAY
 FOR I=1 TO 99
  DO
   SERVICEOUT(I)=FALSE
  END

 LELISTINPUT=GETDATACHARACTER(GETPARAMSYMXCHCLSERVICESXOUT,SYMXINSTANCE,SYMXCLIENTNUM)
 CALL LISTEXPAND
 FOR I=1 TO 99
  DO
   SERVICEOUT(I)=LELIST(I)
  END
END [PROCEDURE BUILD SERVICE ARRAY]

