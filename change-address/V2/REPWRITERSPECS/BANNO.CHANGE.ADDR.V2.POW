PROCEDURE HANDLEFMERROR

 IF FMERROR="" THEN
  DO
   ADDNOTETEXTADD=LEVELCHR+" Name LOC "+LOCATORCHR+" Updated"
   CALL ADDNOTEADD
  END
 ELSE
  DO
   BNOERRORCODE=BNOERRCODEPROCESSCHGS
   BNOERRORMODIFIER=BNOERRMODNAMEMATCHFM
   BNOERRORMODIFIER=LEVELCHR+" Name LOC "+LOCATORCHR+" FM - "+FMERROR

   ADDNOTETEXTADD=LEVELCHR+" Name LOC "+LOCATORCHR
   CALL ADDNOTEADD
   ADDNOTETEXTADD=" FM - "+FMERROR
   CALL ADDNOTEADD
  END
END

PROCEDURE POSTFMPROCESS
[* Clears and sets warning codes upon successful FM. Sends confirmation email to member.
*]
 ADDNOTEHEADER="Banno Address Change SUCCESS"
 IF SYSMEMOMODE=TRUE THEN
  DO
   ADDNOTETEXTADD="FM performed during Memo Mode"
   CALL ADDNOTEADD
  END 
 IF PARAMCLEARWARNING>0 THEN
  DO
   FMPERFORM REVISE ACCOUNT (0,0,CLEARWARNERROR)
    DO
     CLEARWARNING PARAMCLEARWARNING
    END
   IF CLEARWARNERROR<>"" THEN
    DO
     ADDNOTETEXTADD=FORMAT("WARNING #####9 UNSUCCESSFULLY CLEARED: ",PARAMCLEARWARNING)+CLEARWARNERROR
     CALL ADDNOTEADD
    END 
  END

 IF PARAMSETWARNING>0 THEN
  DO
   FMPERFORM REVISE ACCOUNT (0,0,SETWARNERROR)
    DO
     SETWARNING PARAMSETWARNING PARAMSETWARNINGEXPIRATION
    END
   IF SETWARNERROR<>"" THEN
    DO
     ADDNOTETEXTADD=FORMAT("WARNING #####9 UNSUCCESSFULLY SET: ",PARAMSETWARNING)+SETWARNERROR
     CALL ADDNOTEADD
    END   
  END

 IF PARAMSENDEMAIL=TRUE OR
    SYSMEMOMODE=TRUE THEN
  CALL SENDEMAIL

[* Create note with success details
*] 
 CALL ADDNOTECREATE
END [PROCEDURE]

PROCEDURE VALIDATESENDMAILADDR

[* Check for valid email addresses and write to note record if invalid values are found
*]
 EMAILINPUT=MEMBEREMAILFROM
 CALL VALIDATEEMAIL
 IF VALIDEMAILINPUT=FALSE THEN
  DO
   IF MEMBEREMAILFROM="" THEN
    ADDNOTETEXTADD="Member email FROM address is blank - member email not sent"  
   ELSE 
    ADDNOTETEXTADD="Member email FROM address is invalid - member email not sent"  
   CALL ADDNOTEADD
   IF MEMBEREMAILFROM<>"" THEN
    DO
     ADDNOTETEXTADD="Invalid email: "+MEMBEREMAILFROM
     CALL ADDNOTEADD
    END
  END
  
 IF VALIDEMAILINPUT=TRUE THEN
  DO
   EMAILINPUT=MEMBEREMAIL
   CALL VALIDATEEMAIL
   IF VALIDEMAILINPUT=FALSE THEN
    DO
     IF MEMBEREMAIL="" THEN
      ADDNOTETEXTADD="Member email TO address is blank - member email not sent"  
     ELSE 
      ADDNOTETEXTADD="Member email TO address is invalid - member email not sent"  
     CALL ADDNOTEADD
     IF MEMBEREMAIL<>"" THEN
      DO
       ADDNOTETEXTADD="Invalid email: "+MEMBEREMAIL
       CALL ADDNOTEADD
      END
    END  
  END
END

PROCEDURE SENDEMAIL

 CALL VALIDATESENDMAILADDR

[* Send email to user's email address if both from and to emails are valid
*]
 IF VALIDEMAILINPUT=TRUE THEN
  DO
   IF SYSMEMOMODE=FALSE THEN
    MEMBEREMAILSUBJECT=PARAMEMAILSUBJECT(USELANGUAGE)
   ELSE
    MEMBEREMAILSUBJECT=PARAMMEMOEMAILSUBJECT(USELANGUAGE)

   EMAILSTART(MEMBEREMAILFROM,MEMBEREMAIL,MEMBEREMAILSUBJECT,EMAILSENDERROR)
   IF EMAILSENDERROR="" AND
      PARAMEMAILTYPE=EMAILTYPEHTML THEN
    DO
     EMAILLINE("MIME-Version: 1.0",EMAILSENDERROR)
     EMAILLINE("Content-Type: text/html; charset=us-ascii",EMAILSENDERROR)
    END

   IF EMAILSENDERROR="" THEN
    DO
     IF SYSMEMOMODE=FALSE THEN
      DO
       FOR TMPLOOP=1 TO PARAMEMAILLINESCOUNT
        DO
         IF PARAMEMAILLINESLANG(TMPLOOP)=USELANGUAGE THEN
          EMAILLINE(PARAMEMAILLINES(TMPLOOP),EMAILSENDERROR)
        END
      END
     ELSE
      DO
       FOR TMPLOOP=1 TO PARAMMEMOEMAILLINESCOUNT
        DO
         IF PARAMMEMOEMAILLINESLANG(TMPLOOP)=USELANGUAGE THEN
          EMAILLINE(PARAMMEMOEMAILLINES(TMPLOOP),EMAILSENDERROR)
        END
      END 

     EMAILSEND(EMAILSENDERROR)
    END
  
   IF EMAILSENDERROR="" THEN
    DO
     ADDNOTETEXTADD="Member email successfully sent to: "+MEMBEREMAIL
     CALL ADDNOTEADD
    END
   ELSE
    DO
     ADDNOTETEXTADD="SEND MEMBER EMAIL ERROR:"+EMAILSENDERROR
     CALL ADDNOTEADD
     ADDNOTETEXTADD="Member email address: "+MEMBEREMAIL
     CALL ADDNOTEADD
    END 
  END
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  Add Note Procedures
**  --------------------------------------------------------------------
*]
PROCEDURE ADDNOTEADD
[* Adds note line to the array of note lines.  Note gets created when ADDNOTECREATE is called.
*]

 IF ADDNOTETEXTCOUNT<ADDNOTETEXTMAX THEN
  DO
   ADDNOTETEXTCOUNT=ADDNOTETEXTCOUNT+1
   ADDNOTETEXT(ADDNOTETEXTCOUNT)=ADDNOTETEXTADD
   ADDNOTETYPE(ADDNOTETEXTCOUNT)=ADDNOTETYPEADD
  END
 ADDNOTETYPEADD=ADDNOTETYPEGENERAL 
END [PROCEDURE]

PROCEDURE ADDNOTEADDRESET
[* Adds note line but first resets/deletes existing note lines
*]

 ADDNOTETEXTCOUNT=0
 FOR TMPLOOP=1 TO ADDNOTETEXTMAX
  DO
   ADDNOTETEXT(TMPLOOP)=""
  END
 CALL ADDNOTEADD
 ADDNOTETYPEADD=ADDNOTETYPEGENERAL
END [PROCEDURE]

PROCEDURE ADDNOTEADDHEADER

 ADDNOTEHEADER=ADDNOTEHEADERADD
 ADDNOTEHEADERADD=""
END [PROCEDURE]

[* TODO: make sure all the CREATENOTE note calls in v1 are handled in v2
*]
PROCEDURE ADDNOTECREATE
[* Create a note record on the member's account 
*]

 IF BNOERRORCODE<>BNOERRCODESUCCESS AND
    PARAMOVERRIDECONVS=TRUE AND
    @RGSTATE=STATEPROCESSADDRCHANGE THEN
  CALL ADDADDRDETAILSNOTE

 IF BNOERRORCODE<>BNOERRCODESUCCESS AND
    ADDNOTEHEADER="" THEN
  ADDNOTEHEADER="Banno Address Change ERROR"

 ADDNOTESORTEDCOUNT=0
 FOR TMPLOOP=1 TO ADDNOTETEXTCOUNT
  DO
   IF ADDNOTETYPE(TMPLOOP)=ADDNOTETYPEGENERAL THEN
    DO
     ADDNOTESORTEDCOUNT=ADDNOTESORTEDCOUNT+1
     ADDNOTESORTED(ADDNOTESORTEDCOUNT)=ADDNOTETEXT(TMPLOOP)
    END 
  END

[* Member note gets added to the bottom of the note record
*]
 FIRST=TRUE  
 FOR TMPLOOP=1 TO ADDNOTETEXTCOUNT
  DO
   IF ADDNOTETYPE(TMPLOOP)=ADDNOTETYPEMBRNOTE THEN
    DO
     IF FIRST=TRUE THEN
      DO
       ADDNOTESORTEDCOUNT=ADDNOTESORTEDCOUNT+1
       ADDNOTESORTED(ADDNOTESORTEDCOUNT)="Member Note:"
      END
     ADDNOTESORTEDCOUNT=ADDNOTESORTEDCOUNT+1
     ADDNOTESORTED(ADDNOTESORTEDCOUNT)=ADDNOTETEXT(TMPLOOP)
     FIRST=FALSE
    END 
  END 

 FMPERFORM CREATE NOTE LOC BEFOREFIRST (0,0,NEWLOC,FMERROR)
  DO
   SET TEXT:1 TO ADDNOTEHEADER
   SET TEXT:2 TO ADDNOTESORTED(1)
   SET TEXT:3 TO ADDNOTESORTED(2)
   SET TEXT:4 TO ADDNOTESORTED(3)
   SET TEXT:5 TO ADDNOTESORTED(4)
   SET TEXT:6 TO ADDNOTESORTED(5)
   SET TEXT:7 TO ADDNOTESORTED(6)
   SET TEXT:8 TO ADDNOTESORTED(7)
   SET TEXT:9 TO ADDNOTESORTED(8)
   SET TEXT:10 TO ADDNOTESORTED(9)
   SET TEXT:11 TO ADDNOTESORTED(10)
   SET TEXT:12 TO ADDNOTESORTED(11)
   SET TEXT:13 TO ADDNOTESORTED(12)
   SET TEXT:14 TO ADDNOTESORTED(13)
   SET TEXT:15 TO ADDNOTESORTED(14)
   SET TEXT:16 TO ADDNOTESORTED(15)
   SET TEXT:17 TO ADDNOTESORTED(16)
   SET TEXT:18 TO ADDNOTESORTED(17)
   SET TEXT:19 TO ADDNOTESORTED(18)
   SET TEXT:20 TO ADDNOTESORTED(19)
   SET TEXT:21 TO ADDNOTESORTED(20)
   SET TEXT:22 TO ADDNOTESORTED(21)
   SET TEXT:23 TO ADDNOTESORTED(22)
   SET TEXT:24 TO ADDNOTESORTED(23)
   SET TEXT:25 TO ADDNOTESORTED(24)
   SET TEXT:26 TO ADDNOTESORTED(25)
   SET TEXT:27 TO ADDNOTESORTED(26)
   SET TEXT:28 TO ADDNOTESORTED(27)
   SET TEXT:29 TO ADDNOTESORTED(28)
   SET TEXT:30 TO ADDNOTESORTED(29)
   SET TEXT:31 TO ADDNOTESORTED(30)
   SET TEXT:32 TO ADDNOTESORTED(31)
   SET TEXT:33 TO ADDNOTESORTED(32)
   SET TEXT:34 TO ADDNOTESORTED(33)
   SET TEXT:35 TO ADDNOTESORTED(34)
   SET TEXT:36 TO ADDNOTESORTED(35)
   SET TEXT:37 TO ADDNOTESORTED(36)
   SET TEXT:38 TO ADDNOTESORTED(37)
   SET TEXT:39 TO ADDNOTESORTED(38)
   SET TEXT:40 TO ADDNOTESORTED(39)
   SET TEXT:41 TO ADDNOTESORTED(40)
   SET TEXT:42 TO ADDNOTESORTED(41)
   SET TEXT:43 TO ADDNOTESORTED(42)
   SET TEXT:44 TO ADDNOTESORTED(43)
   SET TEXT:45 TO ADDNOTESORTED(44)
   SET TEXT:46 TO ADDNOTESORTED(45)
   SET TEXT:47 TO ADDNOTESORTED(46)
   SET TEXT:48 TO ADDNOTESORTED(47)
   SET TEXT:49 TO ADDNOTESORTED(48)
   SET TEXT:50 TO ADDNOTESORTED(49)
   SET EXPIRATIONDATE TO SYSTEMDATE+NOTEEXPIREDAYS
  END
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  Config File Procedures
**  --------------------------------------------------------------------
*]

PROCEDURE PARAMMSGINIT

 PARAMMSGTAGSCOUNT=0
 PARAMMSGOPT=FALSE
 PARAMMSGMAXLINES=0
 FOR PARAMMSGTAGINDEX=1 TO PARAMMSGTAGSMAX
  DO
   PARAMMSGOPTIONAL(PARAMMSGTAGINDEX)=FALSE
   PARAMMSGDEFINED(PARAMMSGTAGINDEX)=FALSE
   PARAMMSGMAX(PARAMMSGTAGINDEX)=PARAMMSGDEFAULTMAX
  END
END [PROCEDURE] 

PROCEDURE PARAMMSGTAGADD

 IF PARAMMSGTAGSCOUNT<PARAMMSGTAGSMAX THEN
  DO
   PARAMMSGTAGSCOUNT=PARAMMSGTAGSCOUNT+1
   PARAMMSGTAGS(PARAMMSGTAGSCOUNT)=PARAMMSGTAG 
   PARAMMSGPROPS(PARAMMSGTAGSCOUNT)=PARAMMSGPROP
   PARAMMSGOPTIONAL(PARAMMSGTAGSCOUNT)=PARAMMSGOPT
   IF PARAMMSGMAXLINES<>0 THEN 
    PARAMMSGMAX(PARAMMSGTAGSCOUNT)=PARAMMSGMAXLINES
   
   PARAMMSGOPT=FALSE
   PARAMMSGMAXLINES=0
  END
END [PROCEDURE]

PROCEDURE BNOINITPARAMVALS
[* Initialize parameter/cfg variables
*]

 PARAMINELIGACCTTYPESLIST="NONE"
 PARAMWARNINGSACCTLIST="NONE"
 PARAMMATCHNMTYPESLIST="NONE"
 PARAMCLEARWARNINGCHR="NONE"
 PARAMSETWARNINGCHR="NONE"
 PARAMSETWARNINGEXPIRATION=DATENULL
 PARAMPORESTRICT=TRUE
 PARAMOVERRIDECONVS=FALSE
 PARAMSENDEMAIL=FALSE
 PARAMMATCHNAMELVLCHR="NONE"
 PARAMOVERRIDEEMAIL=""
 PARAMEMAILTYPE=EMAILTYPETEXT
 PARAMEMAILSUBJECT(PARAMMSGTAGENGLISH)="Address Update Notice"
 [* TODO: might want a Spanish translation for this
 *]
 PARAMEMAILSUBJECT(PARAMMSGTAGSPANISH)="Address Update Notice"
 PARAMEMAILLINESCOUNT=0

 PARAMMEMOEMAILSUBJECT(PARAMMSGTAGENGLISH)="Update to Financial Institution Address Scheduled"
 [* TODO: might want a Spanish translation for this
 *]
 PARAMMEMOEMAILSUBJECT(PARAMMSGTAGSPANISH)="Update to Financial Institution Address Scheduled"
 PARAMMEMOEMAILLINESCOUNT=0

 PARAMPOBOXLISTFOUND=FALSE
 FOR TMPLOOP=1 TO PARAMPOBOXLISTMAX
  DO
   PARAMPOBOXLIST(TMPLOOP)=""
  END
 
 PARAMALLOWINMEMOMODE=FALSE 

 PARAMERRDISPLAYCOUNT=0
 PARAMLANGSPANISH=FALSE
 PARAMDEBUGMODE=BNODEBUGMODEUNDEFINED
 PARAMTESTMODE=FALSE
 PARAMTESTEC=0
 PARAMPROGINSTALLDATE=DATENULL
END [PROCEDURE]

PROCEDURE BNOSETPARAMVALS
[* Assign parameter settings retrieved from the configuration Letter
** file to variables for use throughout the program
*]
 CALL BNOINITPARAMVALS

 CALL GETPARAMMSGS

[* Get any display error messages if configured in CFG file
*]
 CALL GETERRORDISPLAYMESSAGES
 
[* Ineligible Account Type(s)
*]
 BNOPARAMFIND="IAT"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMINELIGACCTTYPESLIST=BNOPARAMVAL

[* Account warnings restricting access
*]
 BNOPARAMFIND="AW"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMWARNINGSACCTLIST=BNOPARAMVAL

[* Name types to match
*]
 BNOPARAMFIND="MT"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  PARAMMATCHNMTYPESLIST=BNOPARAMVAL

[* Clear warning
*]
 BNOPARAMFIND="CW"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMCLEARWARNINGCHR=BNOPARAMVAL

[* Set warning
*]
 BNOPARAMFIND="SW"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMSETWARNINGCHR=BNOPARAMVAL

[* Set warning expiration date
*]
 BNOPARAMFIND="ED"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND
    VALUE(BNOPARAMVAL)>0 THEN
  PARAMSETWARNINGEXPIRATION=SYSTEMDATE+VALUE(BNOPARAMVAL)

[* PO Box restrict flag
*]
 BNOPARAMFIND="PR"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMPORESTRICT=TRUE
   ELSE 
    PARAMPORESTRICT=FALSE 
  END

[* Override conversations
*]
 BNOPARAMFIND="OC"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMOVERRIDECONVS=TRUE
   ELSE 
    PARAMOVERRIDECONVS=FALSE 
  END     

[* Send email flag
*]
 BNOPARAMFIND="SE"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMSENDEMAIL=TRUE
   ELSE 
    PARAMSENDEMAIL=FALSE 
  END     

[PO box list]
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   BNOPARAMTMP=UPPERCASE(BNOCFGPARAM(BNOPARAMLOOP))
   IF CHARACTERSEARCH(BNOPARAMTMP,"PO BOX LIST")>0 THEN
    DO
     INDEX=VALUE(BNOPARAMTMP)
     IF INDEX>=1 AND 
        INDEX<=PARAMPOBOXLISTMAX AND 
        BNOCFGPARAMVAL(BNOPARAMLOOP)<>"" THEN
      DO
       PARAMPOBOXLIST(INDEX)=UPPERCASE(BNOCFGPARAMVAL(BNOPARAMLOOP))
       PARAMPOBOXLISTFOUND=TRUE
      END
    END
  END  

[* Name levels to match
*]
 BNOPARAMFIND="MN"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  PARAMMATCHNAMELVLCHR=UPPERCASE(BNOPARAMVAL)

[* Override conversations email
*]
 BNOPARAMFIND="OE"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMOVERRIDEEMAIL=BNOPARAMVAL

[* Email type
*]
 BNOPARAMFIND="ET"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  DO
   IF UPPERCASE(BNOPARAMVAL)=PARAMEMAILTYPECHR(EMAILTYPEHTML) THEN
    PARAMEMAILTYPE=EMAILTYPEHTML
   ELSE IF UPPERCASE(BNOPARAMVAL)=PARAMEMAILTYPECHR(EMAILTYPETEXT) THEN
    PARAMEMAILTYPE=EMAILTYPETEXT
  END

[* Email from
*]
 BNOPARAMFIND="EF"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  PARAMEMAILFROM=BNOPARAMVAL

[* Email subject
*]
 BNOPARAMFIND="ES"
 CALL BNOGETPARAMVAL
 IF BNOPARAMVALLANG(PARAMMSGTAGENGLISH)<>"" THEN
  PARAMEMAILSUBJECT(PARAMMSGTAGENGLISH)=BNOPARAMVALLANG(PARAMMSGTAGENGLISH)
 IF BNOPARAMVALLANG(PARAMMSGTAGSPANISH)<>"" THEN
  PARAMEMAILSUBJECT(PARAMMSGTAGSPANISH)=BNOPARAMVALLANG(PARAMMSGTAGSPANISH)

[* Email body lines
*]
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   IF SEGMENT(BNOCFGPARAM(BNOPARAMLOOP),1,2)="EB" THEN
    DO
     BNOPARAMTMP=BNOCFGPARAM(BNOPARAMLOOP)
     CALL PARAMEXTRACTLANG
     IF PARAMEMAILLINESCOUNT<PARAMEMAILLINESMAX THEN
      DO
       PARAMEMAILLINESCOUNT=PARAMEMAILLINESCOUNT+1
       PARAMEMAILLINES(PARAMEMAILLINESCOUNT)=BNOCFGPARAMVAL(BNOPARAMLOOP)
       PARAMEMAILLINESLANG(PARAMEMAILLINESCOUNT)=PARAMMSGTAGLANG
      END
    END
  END

[* Allow address change during memo mode
*]
 BNOPARAMFIND="MMAIC"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMALLOWINMEMOMODE=TRUE
   ELSE 
    PARAMALLOWINMEMOMODE=FALSE 
  END

[* Memo Mode Email subject
*]
 BNOPARAMFIND="MMES"
 CALL BNOGETPARAMVAL
 IF BNOPARAMVALLANG(PARAMMSGTAGENGLISH)<>"" THEN
  PARAMMEMOEMAILSUBJECT(PARAMMSGTAGENGLISH)=BNOPARAMVALLANG(PARAMMSGTAGENGLISH)
 IF BNOPARAMVALLANG(PARAMMSGTAGSPANISH)<>"" THEN
  PARAMMEMOEMAILSUBJECT(PARAMMSGTAGSPANISH)=BNOPARAMVALLANG(PARAMMSGTAGSPANISH)

[* Memo Mode Email body lines
*]
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   IF SEGMENT(BNOCFGPARAM(BNOPARAMLOOP),1,2)="MMEB" THEN
    DO
     BNOPARAMTMP=BNOCFGPARAM(BNOPARAMLOOP)
     CALL PARAMEXTRACTLANG
     IF PARAMMEMOEMAILLINESCOUNT<PARAMEMAILLINESMAX THEN
      DO
       PARAMMEMOEMAILLINESCOUNT=PARAMMEMOEMAILLINESCOUNT+1
       PARAMMEMOEMAILLINES(PARAMMEMOEMAILLINESCOUNT)=BNOCFGPARAMVAL(BNOPARAMLOOP)
       PARAMMEMOEMAILLINESLANG(PARAMMEMOEMAILLINESCOUNT)=PARAMMSGTAGLANG
      END
    END
  END

[Spanish language support]   
 BNOPARAMFIND="SLS"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMLANGSPANISH=TRUE
   ELSE 
    PARAMLANGSPANISH=FALSE 
  END

 BNOPARAMFIND="PID"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  PARAMPROGINSTALLDATE=DATEVALUE(BNOPARAMVAL)

[* Test parameters
*]
 BNOPARAMFIND="DEBUGMODE"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND BNOPARAMVAL<>"" THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMDEBUGMODE=BNODEBUGMODEON
   ELSE 
    PARAMDEBUGMODE=BNODEBUGMODEOFF 
  END

 BNOPARAMFIND="TESTMODE"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE THEN
  DO
   IF CHARACTERSEARCH("TRUEYES1ON",BNOPARAMVAL)>0 THEN
    PARAMTESTMODE=TRUE
  END

 BNOPARAMFIND="TESTEC"
 CALL BNOGETPARAMVAL
 IF BNOPARAMFOUND=TRUE AND
    BNOPARAMVAL<>"" THEN
  PARAMTESTEC=VALUE(BNOPARAMVAL)
END [PROCEDURE]

PROCEDURE PARAMPOSTPROCESS
[* Post-processing of the param/cfg variables
*]

[* After the parameters have been read, set the active language based on param value and language passed to PO
*]
 CALL GETUSELANGUAGE

[* PowerOn-specific post processing goes here
*]
 PARAMCLEARWARNING=VALUE(PARAMCLEARWARNINGCHR)
 PARAMSETWARNING=VALUE(PARAMSETWARNINGCHR)

 BNODATALINE=PARAMMATCHNAMELVLCHR
 BNODLREMOVEPADDING=TRUE
 BNODLDELIMITER=","
 CALL BNOPARSEDATALINE
 FOR BNODLINDEX=1 TO BNODLFIELDCOUNT
  DO
   TMPCHR=BNODLFIELD(BNODLINDEX)
   FOR TMPLOOP=0 TO MATCHNAMELVLMAX
    DO
     IF TMPCHR=MATCHNAMELVLCHR(TMPLOOP) THEN
      DO
       PARAMMATCHNAMELVL(TMPLOOP)=TRUE
       PERFORMMATCHING=TRUE
      END 
    END
  END

 IF PARAMMATCHNAMELVL(NAMELEVELALL)=TRUE THEN
  DO
   FOR TMPLOOP=0 TO MATCHNAMELVLMAX
    DO
     PARAMMATCHNAMELVL(TMPLOOP)=TRUE
    END
  END

[* Update debug mode based on debug parameter and the install date parameter
*]
 IF PARAMDEBUGMODE<>BNODEBUGMODEUNDEFINED THEN
  BNODEBUGMODE=PARAMDEBUGMODE
 ELSE IF PARAMPROGINSTALLDATE<>DATENULL THEN
  DO
   IF PARAMPROGINSTALLDATE+BNODEBUGPRINTINFODAYS>SYSTEMDATE THEN
    BNODEBUGMODE=BNODEBUGMODEON
   ELSE 
    BNODEBUGMODE=BNODEBUGMODEOFF 
  END 

 MEMBEREMAILFROM=PARAMEMAILFROM
 IF MEMBEREMAILFROM="" THEN
  MEMBEREMAILFROM=MEMBEREMAIL

 NEEDMEMBEREMAILINFO=FALSE
 IF PARAMSENDEMAIL=TRUE OR
    PARAMALLOWINMEMOMODE=TRUE THEN
  NEEDMEMBEREMAILINFO=TRUE

[* Pre-validate the type lists
*]
 CALL PREVALIDATETYPELISTS
 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  DO
   LELISTINPUT=PARAMINELIGACCTTYPESLIST
   IF LELISTINPUT="" THEN
    LELISTINPUT="NONE"
   CALL LISTEXPAND
   FOR TMPLOOP=0 TO ACCTTYPESMAX
    DO
     PARAMINELIGACCTTYPES(TMPLOOP)=LELIST(TMPLOOP)
    END
  
   LELISTINPUT=PARAMWARNINGSACCTLIST
   IF LELISTINPUT="" THEN
    LELISTINPUT="NONE"
   CALL LISTEXPAND
   FOR TMPLOOP=0 TO ACCTWARNINGSMAX
    DO
     PARAMWARNINGSACCT(TMPLOOP)=LELIST(TMPLOOP)
    END
  
   LELISTINPUT=PARAMMATCHNMTYPESLIST
   IF LELISTINPUT="" THEN
    LELISTINPUT="NONE"
   CALL LISTEXPAND
   FOR TMPLOOP=0 TO NAMETYPESMAX
    DO
     PARAMMATCHNMTYPES(TMPLOOP)=LELIST(TMPLOOP)
     IF PARAMMATCHNMTYPES(TMPLOOP)=TRUE THEN
      MATCHNMTYPESSET=TRUE
    END
  
   CALL VALIDATEPARAMS
  END

 IF BNOERRORCODE=BNOERRCODECONFIGVALIDATE THEN
  DO
   ADDNOTETEXTADD="Cfg file invalid"
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END   
END [PROCEDURE]

PROCEDURE PREVALIDATETYPELISTS

 LISTEXPANDINPUT=PARAMINELIGACCTTYPESLIST
 CALL VALIDATELISTEXPANDINPUT
 IF VALIDLISTEXPANDINPUT=FALSE THEN
  DO
   BNOERRORCODE=BNOERRCODECONFIGVALIDATE
   BNOERRORMODIFIER=BNOERRMODINVACCTTYPES
  END

 LISTEXPANDINPUT=PARAMWARNINGSACCTLIST
 CALL VALIDATELISTEXPANDINPUT
 IF VALIDLISTEXPANDINPUT=FALSE THEN
  DO
   BNOERRORCODE=BNOERRCODECONFIGVALIDATE
   BNOERRORMODIFIER=BNOERRMODINVWARNTYPES
  END

 LISTEXPANDINPUT=PARAMMATCHNMTYPESLIST
 CALL VALIDATELISTEXPANDINPUT
 IF VALIDLISTEXPANDINPUT=FALSE THEN
  DO
   BNOERRORCODE=BNOERRCODECONFIGVALIDATE
   BNOERRORMODIFIER=BNOERRMODINVMATCHNMTYPES
  END    
END

PROCEDURE VALIDATEPARAMS
[* Validate required parameters to make sure all necessary parameter settings are present and within required ranges
*]
  
 BNOERRORMODIFIER=""

[* Test clear warning type input
*]
 IF PARAMCLEARWARNINGCHR<>"" THEN
  DO
   BNOERRORMODIFIER=BNOERRMODINVCLRWARNTYPE
   IF UPPERCASE(PARAMCLEARWARNINGCHR)="NONE" OR
     (VALUE(PARAMCLEARWARNINGCHR)>=1 AND VALUE(PARAMCLEARWARNINGCHR)<=ACCTWARNINGSMAX) THEN
    BNOERRORMODIFIER="" 
  END

[* Test set warning type input
*]
 IF BNOERRORMODIFIER="" AND 
    PARAMSETWARNINGCHR<>"" THEN
  DO
   BNOERRORMODIFIER=BNOERRMODINVSETWARNTYPE
   IF UPPERCASE(PARAMSETWARNINGCHR)="NONE" OR
     (VALUE(PARAMSETWARNINGCHR)>=1 AND VALUE(PARAMSETWARNINGCHR)<=ACCTWARNINGSMAX) THEN
    BNOERRORMODIFIER="" 
  END

[* If PO Box restrictions are in effect test for PO Box list entry
*]
 IF BNOERRORMODIFIER="" AND
    PARAMPORESTRICT=TRUE AND
    PARAMPOBOXLISTFOUND=FALSE THEN
   BNOERRORMODIFIER=BNOERRMODPOBOXSETUP

[* If name matching name levels are set (not none) and no name types are specified.
*]
 IF BNOERRORMODIFIER="" AND
    PERFORMMATCHING=TRUE AND
    MATCHNMTYPESSET=FALSE THEN
   BNOERRORMODIFIER=BNOERRMODNONMTYPES

[* If email is enabled OR change address allowed during memo mode is enabled, check for email detail lines and 
** validate email address, if specified.
*]
 IF BNOERRORMODIFIER="" AND
    NEEDMEMBEREMAILINFO=TRUE THEN
  DO
   IF PARAMSENDEMAIL=TRUE THEN
    DO
     TMPEMAILLINESCOUNT=0
     FOR TMPLOOP=1 TO PARAMEMAILLINESCOUNT
      DO
       IF PARAMEMAILLINESLANG(TMPLOOP)=USELANGUAGE THEN
        TMPEMAILLINESCOUNT=TMPEMAILLINESCOUNT+1
      END 
     IF TMPEMAILLINESCOUNT=0 THEN
      BNOERRORMODIFIER=BNOERRMODNOEMAILLINES
    END

   IF PARAMALLOWINMEMOMODE=TRUE THEN
    DO
     TMPEMAILLINESCOUNT=0
     FOR TMPLOOP=1 TO PARAMMEMOEMAILLINESCOUNT
      DO
       IF PARAMMEMOEMAILLINESLANG(TMPLOOP)=USELANGUAGE THEN
        TMPEMAILLINESCOUNT=TMPEMAILLINESCOUNT+1
      END  
     IF TMPEMAILLINESCOUNT=0 THEN
      BNOERRORMODIFIER=BNOERRMODNOEMAILLINES
    END

   IF PARAMEMAILFROM<>"" THEN
    DO
     EMAILINPUT=PARAMEMAILFROM
     CALL VALIDATEEMAIL
     IF VALIDEMAILINPUT=FALSE THEN
      BNOERRORMODIFIER=BNOERRMODINVFROMEMAIL
    END  
  END

 IF BNOERRORMODIFIER="" AND
    PARAMOVERRIDECONVS=TRUE THEN
  DO
   EMAILINPUT=PARAMOVERRIDEEMAIL
   CALL VALIDATEEMAIL
   IF VALIDEMAILINPUT=FALSE THEN
    BNOERRORMODIFIER=BNOERRMODINVCONVEMAIL
  END    

 IF BNOERRORMODIFIER<>"" THEN
  BNOERRORCODE=BNOERRCODECONFIGVALIDATE
END [PROCEDURE]

PROCEDURE VALIDATELISTEXPANDINPUT
[* Validate user input as valid listexpand input
**
**  PASS       LISTEXPANDINPUT       User input
**  RETURN     VALIDLISTEXPANDINPUT  Boolean T/F
*]
 VALIDLISTEXPANDINPUT=FALSE
 IF LISTEXPANDINPUT="" THEN
  VALIDLISTEXPANDINPUT=TRUE
 ELSE IF UPPERCASE(LISTEXPANDINPUT)="ALL" THEN
  VALIDLISTEXPANDINPUT=TRUE
 ELSE IF UPPERCASE(LISTEXPANDINPUT)="NONE" THEN
  VALIDLISTEXPANDINPUT=TRUE

 IF VALIDLISTEXPANDINPUT=FALSE THEN
  DO
   VALIDLISTEXPANDINPUT=TRUE
   TMPLOOP=1
   WHILE TMPLOOP<=LENGTH(LISTEXPANDINPUT) AND
         VALIDLISTEXPANDINPUT=TRUE
    DO
     IF CHARACTERSEARCH("0123456789,-",SEGMENT(LISTEXPANDINPUT,TMPLOOP,TMPLOOP))=0 THEN
      VALIDLISTEXPANDINPUT=FALSE
     
     TMPLOOP=TMPLOOP+1
    END
  END 
END [PROCEDURE]

PROCEDURE VALIDATEEMAIL
[* Validate email address
**
**  PASS       EMAILINPUT          Email input
**  RETURN     VALIDEMAILINPUT     Boolean T/F
*]

 VALIDEMAILINPUT=TRUE
 ATPOS=0
 DOTPOS=0
 ATPOS=CHARACTERSEARCH(EMAILINPUT,"@")
 IF ATPOS>0 THEN
  DOTPOS=CHARACTERSEARCH(SEGMENT(EMAILINPUT,ATPOS+1,LENGTH(EMAILINPUT)),".")
 IF ATPOS=0 OR DOTPOS=0 THEN
  VALIDEMAILINPUT=FALSE
END [PROCEDURE]

PROCEDURE GETPARAMMSGS

 PARAMMSGALLCOUNT=0
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   PARAMMSGTAGINDEX=1 
   PARAMMSGTAGFOUND=FALSE
   WHILE PARAMMSGTAGINDEX<=PARAMMSGTAGSCOUNT AND PARAMMSGTAGFOUND=FALSE
    DO
     BNOPARAMTMP=BNOCFGPARAM(BNOPARAMLOOP)
     CALL PARAMEXTRACTLANG
     IF PARAMMSGTAGS(PARAMMSGTAGINDEX)=BNOPARAMTMP THEN
      DO
       PARAMMSGTAGFOUND=TRUE
       IF BNOCFGPARAMVAL(BNOPARAMLOOP)<>"" THEN
        PARAMMSGDEFINED(PARAMMSGTAGINDEX)=TRUE

       IF PARAMMSGALLCOUNT<PARAMMSGALLMAX THEN
        DO
         PARAMMSGALLLANG=PARAMMSGTAGLANG
         PARAMMSGALLTAG=BNOPARAMTMP
         PARAMMSGALLVAL=BNOCFGPARAMVAL(BNOPARAMLOOP)
         CALL PARAMMSGALLADD
        END 
      END
     PARAMMSGTAGINDEX=PARAMMSGTAGINDEX+1
    END
  END
END [PROCEDURE]

PROCEDURE PARAMMSGALLADD
[* Update the PARAMMSGALL arrays
**
**  PASS    PARAMMSGALLLANG      Language (English or Spanish)
**  PASS    PARAMMSGALLTAG       Message tag
**  PASS    PARAMMSGALLVAL       Message text/value
*]

 PARAMMSGALLCOUNT=PARAMMSGALLCOUNT+1
 PARAMMSGALLTAGSLANG(PARAMMSGALLCOUNT)=PARAMMSGALLLANG
 PARAMMSGALLTAGS(PARAMMSGALLCOUNT)=PARAMMSGALLTAG
 BNOTEXT=PARAMMSGALLVAL
 CALL BNOCLEANUPTEXT
 PARAMMSGALL(PARAMMSGALLCOUNT)=BNOTEXT
END [PROCEDURE]

PROCEDURE PARAMMSGALLFIND
[* Check to see if a tag and message already exists in the PARAMMSGALL arrays
**
**  PASS    PARAMMSGALLLANG      Language (English or Spanish)
**  PASS    PARAMMSGALLTAG       Message tag
*]

 TMPLOOP=1
 PARAMMSGALLTAGFOUND=FALSE
 WHILE TMPLOOP<=PARAMMSGALLCOUNT AND PARAMMSGALLTAGFOUND=FALSE
  DO
   IF PARAMMSGALLTAGSLANG(TMPLOOP)=PARAMMSGALLLANG AND
      PARAMMSGALLTAGS(TMPLOOP)=PARAMMSGALLTAG AND
      PARAMMSGALL(TMPLOOP)<>"" THEN
    PARAMMSGALLTAGFOUND=TRUE  
   TMPLOOP=TMPLOOP+1
  END
END [PROCEDURE]

PROCEDURE BNOCFGFILEREAD
[* Open and read through the parameter file to create an array of
** parameter names and associated values.
**
**  PASS    BCFGFILENAME      Parameter Letter file name
**  PASS    BNOCFGPARAMMAX    Maximum number of parameters
**  
**  RETURN  BNOCFGFILEFERROR  File open/read error
**  RETURN  BNOERRORCODE      Error code
**  RETURN  BNOCFGPARAM(A)    Parameter Name
**  RETURN  BNOCFGPARAMVAL(A) Parameter Value
**  RETURN  BNOCFGPARAMCOUNT  Parameters Found
**
*]
 BNOCFGPARAMALLOWDUPS=TRUE
 BNOCFGFILEFERROR=""
 BNOCFGPARAMCOUNT=0
 WHILELIMIT=1000000
 FILEOPEN("LETTER",BNOCFGFILENAME,"READ",BNOCFGFILENUMBER,BNOCFGFILEFERROR)
 IF BNOCFGFILEFERROR<>"" THEN
  DO
   BNOERRORCODE=BNOERRCODECONFIGREAD
   BNOERRORMODIFIER=BNOERRMODOPEN
   BNOERRORMODIFIER=BNOCFGFILENAME+" open error - "+BNOCFGFILEFERROR
   BNODEBUGMSG="Error opening CFG param file: "+BNOCFGFILEFERROR
   CALL BNODEBUGMSGADD
  END
 ELSE
  DO
   WHILE BNOCFGFILEFERROR="" AND BNOCFGPARAMCOUNT<BNOCFGPARAMMAX 
    DO
     FILEREADLINE(BNOCFGFILENUMBER,BNOCFGFILELINE,BNOCFGFILEFERROR)
     IF BNOCFGFILEFERROR<>"" AND
        BNOCFGFILEFERROR<>"EOF" THEN
      DO
       BNOERRORCODE=BNOERRCODECONFIGREAD
       BNOERRORMODIFIER=BNOERRMODREAD
       BNOERRORMODIFIER=BNOCFGFILENAME+" read error - "+BNOCFGFILEFERROR
       BNODEBUGMSG="Error reading CFG param file: "+BNOCFGFILEFERROR
       CALL BNODEBUGMSGADD
      END
     ELSE
      DO
       BNOPOS=CHARACTERSEARCH(BNOCFGFILELINE,":")
       IF SEGMENT(BNOCFGFILELINE,1,1)<>"*" AND BNOPOS>1 THEN
        DO
         BNOTEXT=SEGMENT(BNOCFGFILELINE,1,BNOPOS-1)
         CALL BNONLTS
         BNOPARAMTMP=BNOTEXT

         BNOTEXT=SEGMENT(BNOCFGFILELINE,BNOPOS+1,LENGTH(BNOCFGFILELINE))
         CALL BNONLS
         BNOPARAMVALTMP=BNOTEXT

         BNOPARAMFOUND=FALSE
         IF BNOCFGPARAMALLOWDUPS=FALSE THEN 
          DO
           FOR BNOTMPLOOP=1 TO BNOCFGPARAMCOUNT
            DO
             IF BNOCFGPARAM(BNOTMPLOOP)=BNOPARAMTMP THEN
              BNOPARAMFOUND=TRUE
            END
           IF BNOPARAMFOUND=TRUE THEN
            DO
             BNOERRORCODE=BNOERRCODECONFIGVALIDATE
             BNOERRORMODIFIER=BNOERRMODDUPLICATEPARAM
             BNOERRORMODIFIER="Duplicate Param file entry("+BNOPARAMTMP+")"
             BNODEBUGMSG="Duplicate Param file entry: "+BNOPARAMTMP
             CALL BNODEBUGMSGADD
            END
          END

         IF BNOPARAMFOUND=FALSE THEN
          DO
           BNOCFGPARAMCOUNT=BNOCFGPARAMCOUNT+1
           BNOCFGPARAM(BNOCFGPARAMCOUNT)=BNOPARAMTMP
           BNOCFGPARAMVAL(BNOCFGPARAMCOUNT)=BNOPARAMVALTMP
          END
        END  [IF SEGMENT(BNOCFGFILELINE,1,1)<>"*"]
      END  [IF BNOCFGFILEFERROR=""]
    END  [WHILE BNOCFGFILEFERROR=""]
  END

 FILECLOSE(BNOCFGFILENUMBER,BNOCFGFILEFERROR)
END [PROCEDURE]

PROCEDURE BNOCFGDEBUGADD
[* Add CFG lines to debug
*]

 IF BNODEBUGMODE=BNODEBUGMODEON AND
    BNODEBUGINCLUDEPARAMS=TRUE THEN
  DO
   FOR TMPLOOP=1 TO BNOCFGPARAMCOUNT
    DO
     BNOTEXT=BNOCFGPARAMVAL(TMPLOOP)
     CALL BNOCLEANUPTEXT
     BNODEBUGMSG="PARAM:"+BNOCFGPARAM(TMPLOOP)+"-"+
                  BNOTEXT
     CALL BNODEBUGMSGADD
    END
  END
END [PROCEDURE]

PROCEDURE BNOGETPARAMVAL
[* Find requested parameter setting and return value.
**
**  PASS    BNOPARAMFIND   Targeted parameter setting
**  
**  RETURN  BNOPARAMFOUND  T/F found flag
**  RETURN  BNOPARAMVAL    Parameter value found
*] 
 BNOPARAMFOUND=FALSE
 BNOPARAMVAL=""
 BNOPARAMVALLANG(PARAMMSGTAGENGLISH)=""
 BNOPARAMVALLANG(PARAMMSGTAGSPANISH)=""
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   BNOPARAMTMP=BNOCFGPARAM(BNOPARAMLOOP)
   CALL PARAMEXTRACTLANG
   IF BNOPARAMTMP=BNOPARAMFIND THEN
    DO
     BNOPARAMVAL=BNOCFGPARAMVAL(BNOPARAMLOOP)
     BNOPARAMVALLANG(PARAMMSGTAGLANG)=BNOCFGPARAMVAL(BNOPARAMLOOP)
     BNOPARAMFOUND=TRUE
     BNOPARAMLOOP=BNOCFGPARAMCOUNT
    END
  END
END [PROCEDURE]

PROCEDURE GETERRORDISPLAYMESSAGES
[* Find the error display lines
*] 
 
 FOR BNOPARAMLOOP=1 TO BNOCFGPARAMCOUNT
  DO
   IF SEGMENT(BNOCFGPARAM(BNOPARAMLOOP),1,3)="EDM" THEN
    DO
     BNOPARAMTMP=BNOCFGPARAM(BNOPARAMLOOP)
     CALL PARAMEXTRACTLANG
     TMPERRCODE=VALUE(SEGMENT(BNOPARAMTMP,4,6))
     IF CHARACTERSEARCH(BNOERRDISPLAYLIST,FORMAT("999",TMPERRCODE))>0 THEN
      DO
       BNOTEXT=BNOCFGPARAMVAL(BNOPARAMLOOP)
       CALL BNONTS
       CALL BNOCLEANUPTEXT
       TMPDISPLAYLINE=BNOTEXT
       CALL PARAMERRDISPLAYADD
      END
    END
  END
END [PROCEDURE]

PROCEDURE PARAMEXTRACTLANG
[* Extract language suffix and set PARAMMSGTAGLANG.  Return updated BNOPARAMTMP variable.
*]

 PARAMMSGTAGLANG=PARAMMSGTAGENGLISH
 TAGSFXPOS=CHARACTERSEARCH(BNOPARAMTMP,PARAMMSGTAGENGLISHSFX)
 IF TAGSFXPOS<>0 AND
    TAGSFXPOS=LENGTH(BNOPARAMTMP)-2 THEN
  BNOPARAMTMP=SEGMENT(BNOPARAMTMP,1,LENGTH(BNOPARAMTMP)-3)
 TAGSFXPOS=CHARACTERSEARCH(BNOPARAMTMP,PARAMMSGTAGSPANISHSFX)
 IF TAGSFXPOS<>0 AND
    TAGSFXPOS=LENGTH(BNOPARAMTMP)-2 THEN
  DO
   BNOPARAMTMP=SEGMENT(BNOPARAMTMP,1,LENGTH(BNOPARAMTMP)-3)
   PARAMMSGTAGLANG=PARAMMSGTAGSPANISH
  END 
END [PROCEDURE]

PROCEDURE PARAMERRDISPLAYADD

 IF PARAMERRDISPLAYCOUNT<PARAMERRDISPLAYMAX THEN
  DO
   PARAMERRDISPLAYCOUNT=PARAMERRDISPLAYCOUNT+1
   PARAMERRDISPLAYERRCODES(PARAMERRDISPLAYCOUNT)=TMPERRCODE
   PARAMERRDISPLAYLANG(PARAMERRDISPLAYCOUNT)=PARAMMSGTAGLANG
   BNOTEXT=TMPDISPLAYLINE
   CALL BNONTS
   PARAMERRDISPLAYLINES(PARAMERRDISPLAYCOUNT)=BNOTEXT
  END
END [PROCEDURE]

PROCEDURE BNOERRDISPLAYLISTADD
[* Add to the list of errors that support error display messages.  Used to 
** register those error codes that support display messages.
*]

 IF BNOERRDISPLAYLIST<>"" THEN
  BNOERRDISPLAYLIST=BNOERRDISPLAYLIST+","
 BNOERRDISPLAYLIST=BNOERRDISPLAYLIST+FORMAT("999",BNOERRDISPLAYCODE)
END [PROCEDURE]

PROCEDURE GETBNOERRDISPLAYMSG

 PARAMERRDISPLAYINDEX=1
 BNOERRDISPLAYMSGCOUNT=0
 WHILE PARAMERRDISPLAYINDEX<=PARAMERRDISPLAYCOUNT AND
       BNOERRDISPLAYMSGCOUNT<BNOERRDISPLAYMSGSMAX
  DO
   IF PARAMERRDISPLAYERRCODES(PARAMERRDISPLAYINDEX)=BNOERRCODE AND
      PARAMERRDISPLAYLANG(PARAMERRDISPLAYINDEX)=USELANGUAGE THEN
    DO
     BNOERRDISPLAYMSGCOUNT=BNOERRDISPLAYMSGCOUNT+1
     BNOERRDISPLAYMSG(BNOERRDISPLAYMSGCOUNT)=PARAMERRDISPLAYLINES(PARAMERRDISPLAYINDEX)
    END  
   PARAMERRDISPLAYINDEX=PARAMERRDISPLAYINDEX+1
  END

 IF BNOERRDISPLAYMSGCOUNT=1 AND
    BNOERRDISPLAYMSG(1)="" THEN
  BNOERRDISPLAYMSGCOUNT=0  
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  JSON Procedures
**  --------------------------------------------------------------------
*]

PROCEDURE JSONRESPONSE
[* Output the JSON for an error response
*]

 CALL BNOERRGETMESSAGE

 JSONPROPNAME="responseCode"
 CALL JSONPROPFIRST
 PRINT QQ+FORMAT("999",BNOERRCODE)+QQ
 NEWLINE

 JSONPROPNAME="loggingErrorMessage"
 CALL JSONPROP
 PRINT QQ+BNOERRMESSAGE
 IF BNOERRMODIFIER<>"" THEN
  PRINT ": "+BNOERRMODIFIER
 PRINT QQ
 NEWLINE

 JSONPROPNAME="results"
 CALL JSONPROP
 CALL JSONOBJ
 NEWLINE
 
 JSONOBJFIRSTPROP=TRUE
 CALL JSONGENERALSPECS

 JSONPROPNAME="errorCode"
 CALL JSONPROP
 PRINT FORMAT("999",BNOERRCODE)
 NEWLINE

 JSONPROPNAME="errorMessage"
 CALL JSONPROP
 PRINT QQ+BNOERRMESSAGE
 IF BNOERRMODIFIER<>"" THEN
  PRINT ": "+BNOERRMODIFIER
 PRINT QQ
 NEWLINE

 CALL GETBNOERRDISPLAYMSG

[* Fall back to English message if no Spanish message defined for the error display message
*]
 IF BNOERRDISPLAYMSGCOUNT=0 AND
    USELANGUAGE=PARAMMSGTAGSPANISH THEN
  DO
   USELANGUAGE=PARAMMSGTAGENGLISH
   CALL GETBNOERRDISPLAYMSG
  END  
 
 IF BNOERRDISPLAYMSGCOUNT>0 THEN
  DO
   JSONPROPNAME="errorDisplayMessage"
   CALL JSONPROP

   CALL JSONARRAY
   FOR TMPLOOP=1 TO BNOERRDISPLAYMSGCOUNT
    DO
     BNOTEXT=BNOERRDISPLAYMSG(TMPLOOP)
     CALL BNONTS
     PRINT QQ+BNOTEXT+QQ
     IF TMPLOOP<BNOERRDISPLAYMSGCOUNT THEN
      PRINT ","
     NEWLINE
    END
   CALL JSONARRAYEND
  END

 CALL JSONOBJEND [results property]
END [PROCEDURE]

PROCEDURE JSONGENERALSPECS
[* Output the generalSpecifications JSON object
*]

 JSONPROPNAME="generalSpecifications"
 CALL JSONPROP
 CALL JSONOBJ
 NEWLINE

 JSONOBJFIRSTPROP=TRUE
 CALL JSONPROGRAMINFO
 CALL JSONSYSTEMINFO

 CALL JSONOBJEND
END [PROCEDURE]

PROCEDURE JSONPROGRAMINFO
[* Output the programInfo JSON object
*]

 JSONPROPNAME="programInfo"
 CALL JSONPROP
 CALL JSONOBJ
 NEWLINE

 JSONPROPNAME="name"
 CALL JSONPROPFIRST
 PRINT QQ+BNOPROGRAMNAME+QQ
 NEWLINE
 JSONPROPNAME="version"
 CALL JSONPROP
 PRINT QQ+BNOPROGRAMVERSION+QQ
 NEWLINE
 JSONPROPNAME="lastModDate"
 CALL JSONPROP
 PRINT QQ+FORMAT("99/99/99 ",BNOLASTMODDATE)+BNOLASTMODTIME+QQ
 NEWLINE
 JSONPROPNAME="language"
 CALL JSONPROP
 PRINT USELANGUAGE
 NEWLINE

 IF BNOPROGRAMNOTE1<>"" THEN
  DO
   JSONPROPNAME="note1"
   CALL JSONPROP
   PRINT QQ+BNOPROGRAMNOTE1+QQ
   NEWLINE
  END 
 IF BNOPROGRAMNOTE2<>"" THEN
  DO
   JSONPROPNAME="note2"
   CALL JSONPROP
   PRINT QQ+BNOPROGRAMNOTE2+QQ
   NEWLINE
  END 

 CALL JSONOBJEND
END [PROCEDURE]

PROCEDURE JSONSYSTEMINFO
[* Output the systemInfo JSON object
*]

 JSONPROPNAME="systemInfo"
 CALL JSONPROP
 CALL JSONOBJ
 NEWLINE

 JSONPROPNAME="systemDate"
 CALL JSONPROPFIRST
 PRINT QQ+FORMAT("99/99/9999",SYSTEMDATE)+QQ
 NEWLINE

 JSONPROPNAME="slidLength"
 CALL JSONPROP
 PRINT BNOIDLENGTH
 NEWLINE

 JSONPROPNAME="memoMode"
 CALL JSONPROP
 PRINT JSONBOOLEAN(SYSMEMOMODE)
 NEWLINE

 CALL JSONOBJEND
END [PROCEDURE]

PROCEDURE JSONMSGARRAYS
 
 PARAMMSGTAGINDEX=1 
 WHILE PARAMMSGTAGINDEX<=PARAMMSGTAGSCOUNT
  DO
   MSGTAGSELECTED=FALSE
   IF PARAMMSGOPTIONAL(PARAMMSGTAGINDEX)=FALSE OR
     (PARAMMSGOPTIONAL(PARAMMSGTAGINDEX)=TRUE AND
      PARAMMSGDEFINED(PARAMMSGTAGINDEX)=TRUE) THEN
    MSGTAGSELECTED=TRUE

   IF MSGTAGSELECTED=TRUE AND
      PARAMMSGPROPS(PARAMMSGTAGINDEX)="" THEN
    MSGTAGSELECTED=FALSE

   IF MSGTAGSELECTED=TRUE AND
      MSGPROPSELECTLIST<>"" THEN
    DO
     MSGTAGSELECTED=FALSE
     BNODATALINE=MSGPROPSELECTLIST
     BNODLDELIMITER=","
     CALL BNOPARSEDATALINE
     FOR BNODLINDEX=1 TO BNODLFIELDCOUNT
      DO
       TMPCHR=BNODLFIELD(BNODLINDEX)
       COLONPOS=CHARACTERSEARCH(TMPCHR,":")
       IF COLONPOS>1 AND COLONPOS<LENGTH(TMPCHR) THEN
        DO
         TMPMSGPROP=SEGMENT(TMPCHR,1,COLONPOS-1)
         TMPMSGTAG=SEGMENT(TMPCHR,COLONPOS+1,LENGTH(TMPCHR))
        END
       ELSE
        DO 
         TMPMSGPROP=TMPCHR
         TMPMSGTAG=""
        END 
       
       IF TMPMSGPROP=PARAMMSGPROPS(PARAMMSGTAGINDEX) AND
         (TMPMSGTAG="" OR
          TMPMSGTAG=PARAMMSGTAGS(PARAMMSGTAGINDEX)) THEN
        MSGTAGSELECTED=TRUE  
      END
    END

   IF MSGTAGSELECTED=TRUE THEN 
    DO
     JSONPROPNAME=PARAMMSGPROPS(PARAMMSGTAGINDEX)
     CALL JSONPROP
     CALL JSONARRAY
     NEWLINE
  
     LINECOUNT=0
     FOR PARAMMSGALLINDEX=1 TO PARAMMSGALLCOUNT
      DO
       IF PARAMMSGALLTAGSLANG(PARAMMSGALLINDEX)=USELANGUAGE AND
          PARAMMSGALLTAGS(PARAMMSGALLINDEX)=PARAMMSGTAGS(PARAMMSGTAGINDEX) AND
          LINECOUNT<PARAMMSGMAX(PARAMMSGTAGINDEX) THEN
        DO
         LINECOUNT=LINECOUNT+1
         IF LINECOUNT<>1 THEN
          PRINT ","
         PRINT QQ+PARAMMSGALL(PARAMMSGALLINDEX)+QQ
         NEWLINE 
        END
      END
     CALL JSONARRAYEND
    END  
   
   PARAMMSGTAGINDEX=PARAMMSGTAGINDEX+1
  END

 MSGPROPSELECTLIST="" 
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  JSON Procedures - Common
**  --------------------------------------------------------------------
*]
PROCEDURE JSONOPEN
[* Output JSON open char
*]
 PRINT "{"
 NEWLINE
END [PROCEDURE]

PROCEDURE JSONCLOSE
[* Output JSON close char
*]
 PRINT "}"
 NEWLINE
END [PROCEDURE]

PROCEDURE JSONOBJ
[* Output JSON object open char
*]
 PRINT "{"
END [PROCEDURE]

PROCEDURE JSONOBJEND
[* Output JSON object close char
*]
 PRINT "}"
 NEWLINE
END [PROCEDURE]

PROCEDURE JSONARRAY
[* Output JSON array open char
*]
 PRINT "["
END [PROCEDURE]

PROCEDURE JSONARRAYEND
[* Output JSON array close char
*]
 PRINT "]"
 NEWLINE
END [PROCEDURE]

PROCEDURE JSONPROPFIRST
 JSONOBJFIRSTPROP=TRUE
 CALL JSONPROP
END

PROCEDURE JSONPROP
[* Output JSON property name
*]
 IF JSONOBJFIRSTPROP=FALSE THEN
  PRINT ","
 PRINT QQ+JSONPROPNAME+QQ+":"
 JSONOBJFIRSTPROP=FALSE
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  Debug/Error Processing Procedures
**  --------------------------------------------------------------------
*]

PROCEDURE BNOERRINIT
[* Initialize BNOERR variables
*]

 BNOERRCOUNT=0
 BNOERRMESSAGE=""
 BNOERRDISPLAYMSGCOUNT=0
END [PROCEDURE]

PROCEDURE BNOERRADD
[* Adds an error code to the valid list of error codes
**
**  PASS    BNOERRCODE       Numeric error code
**  PASS    BNOERRMESSAGE    Error description
*]

 IF BNOERRCOUNT<BNOERRMAX THEN
  DO
   BNOERRCOUNT=BNOERRCOUNT+1
   BNOERRCODES(BNOERRCOUNT)=BNOERRCODE
   BNOERRMESSAGES(BNOERRCOUNT)=BNOERRMESSAGE
  END
END [PROCEDURE]

PROCEDURE BNOERRUPDATE
[* Updates an error code error message.  Used to override the error code
** message that was assigned in the SETUP division of the PowerOn.
**
**  PASS    BNOERRCODE       Numeric error code
**  PASS    BNOERRMESSAGE    Error description
*]

 BNOERRTMPCOUNT=1
 BNOERRFOUND=FALSE
 WHILE BNOERRTMPCOUNT<=BNOERRCOUNT AND 
       BNOERRFOUND=FALSE
  DO
   IF BNOERRCODES(BNOERRTMPCOUNT)=BNOERRCODE THEN
    DO
     BNOERRFOUND=TRUE
     BNOERRMESSAGES(BNOERRTMPCOUNT)=BNOERRMESSAGE
    END
   BNOERRTMPCOUNT=BNOERRTMPCOUNT+1
  END
 BNOERRMESSAGE=""
END [PROCEDURE]

PROCEDURE BNOERRGETMESSAGE
[* Gets the error message associated with the BNOERRORCODE
**
**  PASS    BNOERRORCODE     Numeric error code
**  PASS    BNOERRORMODIFIER Msg modifier
**
**  RETURN  BNOERRCODE       Error code
**  RETURN  BNOERRMESSAGE    Error description
**  RETURN  BNOERRMODIFIER   Msg modifier
*]

 BNOERRMESSAGE=BNOERRUNDEFINED
 BNOERRMODIFIER=""
 BNOERRCODE=BNOERRORCODE
 BNOERRTMPCOUNT=1
 WHILE BNOERRTMPCOUNT<=BNOERRCOUNT AND 
       BNOERRMESSAGE=BNOERRUNDEFINED
  DO
   IF BNOERRCODES(BNOERRTMPCOUNT)=BNOERRORCODE THEN
    DO
     BNOERRMESSAGE=BNOERRMESSAGES(BNOERRTMPCOUNT)
     IF BNOERRORMODIFIER<>"" THEN
      BNOERRMODIFIER=BNOERRORMODIFIER
    END 
   BNOERRTMPCOUNT=BNOERRTMPCOUNT+1
  END
END [PROCEDURE]

PROCEDURE BNODEBUGMSGADD
[* Add a message line to the debug message array
**
** PASS    BNODEBUGMSGMAX     Current array index max lines allowed
** PASS    BNODEBUGMSG        Debug message to add to array
**
** RETURN  BNODEBUGCOUNT      Count of debug message lines
** RETURN  BNODEBUGMSGLIST(A) Debug lines of data to print
*]
 IF BNODEBUGCOUNT<BNODEBUGMSGMAX THEN
  DO
   BNODEBUGCOUNT=BNODEBUGCOUNT+1
   BNODEBUGMSGLIST(BNODEBUGCOUNT)=BNODEBUGMSG
   BNODEBUGMSG=""
  END
END [PROCEDURE]

PROCEDURE BNOJSONRGDATA
[* Print @RGUSER[CHR,NUM] data passed from the UX in proper JSON format
**
**  PASS    DEBUGMODE        Boolean: Print debug data, T/F
*]

 IF BNODEBUGMODE=BNODEBUGMODEON THEN
  DO
   JSONPROPNAME="rgData"
   CALL JSONPROP
   CALL JSONARRAY
   NEWLINE
   PRINT QQ+"CHR1:'"+@RGUSERCHR1+"' "+
            "CHR2:'"+@RGUSERCHR2+"'"+QQ+","
   NEWLINE
   PRINT QQ+"CHR3:'"+@RGUSERCHR3+"' "+
            "CHR4:'"+@RGUSERCHR4+"'"+QQ+","
                     
   NEWLINE
   PRINT QQ+"CHR5:'"+@RGUSERCHR5+"' "+
            "NUM1:"+FORMAT("#########9 ",@RGUSERNUM1)+
            "NUM2:"+FORMAT("#########9 ",@RGUSERNUM2)+
            "NUM3:"+FORMAT("#########9 ",@RGUSERNUM3)+
            "NUM4:"+FORMAT("#########9 ",@RGUSERNUM4)+
            "NUM5:"+FORMAT("#########9",@RGUSERNUM5)+QQ
   NEWLINE
   CALL JSONARRAYEND
  END
END [PROCEDURE]

PROCEDURE BNOJSONDEBUGDATA
[* Print debug output in proper JSON format. Requires DEBUGMODE to be
** on (or true).
**
**  PASS  DEBUGMODE           Boolean: Print debug data, T/F
**  PASS  BNODEBUGMSGLIST(A)  Array of debug messages to print
**  PASS  BNODEBUGCOUNT       Number of debug lines to print
*]
 IF BNODEBUGMODE=BNODEBUGMODEON THEN
  DO
   JSONPROPNAME="debugData"
   CALL JSONPROP
   CALL JSONARRAY
   NEWLINE
   PRINT QQ+"Debug note: Debug lines truncated to 126 characters"+QQ
   NEWLINE
   FOR BNODEBUGLOOP=1 TO BNODEBUGCOUNT
    DO
     PRINT ","+QQ+Segment(BNODEBUGMSGLIST(BNODEBUGLOOP),1,126)+QQ
     NEWLINE
    END
   CALL JSONARRAYEND
  END
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  Utility Procedures
**  --------------------------------------------------------------------
*]
PROCEDURE BNONLTS
[* Remove leading and trailing spaces
**  PASS       BNOTEXT
**  RETURN     BNOTEXT
*]
 CALL BNONTS
 CALL BNONLS
END [PROCEDURE]

PROCEDURE BNONLS
[* Remove leading spaces
**  PASS       BNOTEXT
**  RETURN     BNOTEXT
*]
 IF LENGTH(BNOTEXT)=0 THEN
  BNOTEXT=""
 ELSE
  DO
   WHILE (LENGTH(BNOTEXT)>0 AND
          SEGMENT(BNOTEXT,1,1)=" ")
    DO
     BNOTEXT=SEGMENT(BNOTEXT,2,LENGTH(BNOTEXT))
    END
  END
END [PROCEDURE]

PROCEDURE BNONTS
[* Remove trailing spaces
**  PASS       BNOTEXT
**  RETURN     BNOTEXT
*]
 IF BNOTEXT<>"" THEN
  BNOTEXT=SEGMENT(BNOTEXT,1,LENGTH(BNOTEXT))
END [PROCEDURE]

PROCEDURE BNONLZ
[* Removes leading zeros. Does not remove leading spaces.
** '00123' results in '123'.
** ' 0123' results in ' 0123'
** '00000' results in ''.
** As a byproduct, trailing spaces are also removed.
**
**  PASS       BNOTEXT
**  RETURN     BNOTEXT
*]
 IF BNOTEXT<>"" THEN
  DO
   WHILE (SEGMENT(BNOTEXT,1,1)="0")
    DO
     IF LENGTH(BNOTEXT)=1 THEN
      BNOTEXT=""
     ELSE
      BNOTEXT=SEGMENT(BNOTEXT,2,LENGTH(BNOTEXT))
    END
  END
END [PROCEDURE]

PROCEDURE BNOAMTTEXT
[* Formats an amount string with dollars/cents and decimal and no leading spaces
**  PASS       BNOAMT
**  RETURN     BNOTEXT
*]

 BNOTEXT=FORMAT("#######9.99",BNOAMT)
 CALL BNONLS
 IF BNOAMT<$0.00 THEN
  BNOTEXT="-"+BNOTEXT
END [PROCEDURE]

PROCEDURE BNOAMTTEXTDISPLAY
[* Formats an amounts string for display
**  PASS       BNOAMT
**  RETURN     BNOTEXT
*]

 BNOTEXT=FORMAT("##,###,##9.99",BNOAMT)
 CALL BNONLS
 BNOTEXT="$"+BNOTEXT
 IF BNOAMT<$0.00 THEN
  BNOTEXT="-"+BNOTEXT
END [PROCEDURE]

PROCEDURE BNORATETEXT
[* Formats an rate string with 3 decimal places and no leading spaces
**  PASS       BNORATE
**  RETURN     BNOTEXT
*]
 
 BNOTEXT=FORMAT("##9.999",BNORATE)
 CALL BNONLS
END [PROCEDURE]

PROCEDURE BNORATETEXTDISPLAY
[* Formats an rate string for display
**  PASS       BNORATE
**  RETURN     BNOTEXT
*]

 CALL BNORATETEXT
 BNOTEXT=BNOTEXT+"%"
END [PROCEDURE]

PROCEDURE BNONUMTEXT
[* Formats a number string with leading neg sign(-) for negative numbers.  No commas
** or spaces.
**  PASS       BNONUM
**  RETURN     BNOTEXT
*]

 BNOTEXT=FORMAT("#########9",BNONUM)
 CALL BNONLS
 IF BNONUM<0 THEN
  BNOTEXT="-"+BNOTEXT
END [PROCEDURE]

PROCEDURE BNONUMTEXTDISPLAY
[* Formats a number string for display
**  PASS       BNONUM
**  RETURN     BNOTEXT
*]

 BNOTEXT=FORMAT("#,###,###,##9",BNONUM)
 CALL BNONLS
 IF BNONUM<0 THEN
  BNOTEXT="-"+BNOTEXT
END [PROCEDURE]

PROCEDURE BNOCLEANUPINIT

 LELISTINPUT=BNOCLEANVALIDCHRLIST
 CALL LISTEXPAND
 FOR BNOCLEANLOOP=0 TO BNOCLEANVALIDCHRMAX
  DO
   BNOCLEANVALIDCHRS(BNOCLEANLOOP)=LELIST(BNOCLEANLOOP)
  END
END [PROCEDURE]

PROCEDURE BNOCLEANUPTEXT
[* Check character string and remove out any characters or hidden characters which have an ASCII value
** which is not established in the BNOCLEANVALIDCHRLIST string in the SETUP division . This is to avoid
** display issues with displaying the terms or conditions. Additionally, if a back-slash or double 
** quote is encountered, add a preceding backslash.
**
**  PASS       BNOTEXT   String to test
**  RETURN     BNOTEXT   Updated string
*]
 
 TMPCHR=""
 FOR BNOCLEANLOOP=1 TO LENGTH(BNOTEXT)
  DO
   CHRVAL=CHRVALUE(SEGMENT(BNOTEXT,BNOCLEANLOOP,BNOCLEANLOOP))
   IF  BNOCLEANVALIDCHRS(CHRVAL)=TRUE THEN
    DO
[* Check for back-slash or double-quote. If found, precede with a back-slash
*]
     IF CHRVAL=CHRVALBACKSLASH OR CHRVAL=CHRVALQUOTE THEN
      TMPCHR=TMPCHR+CTRLCHR(CHRVALBACKSLASH)+SEGMENT(BNOTEXT,BNOCLEANLOOP,BNOCLEANLOOP)
     ELSE
      TMPCHR=TMPCHR+SEGMENT(BNOTEXT,BNOCLEANLOOP,BNOCLEANLOOP)
    END
  END
 BNOTEXT=TMPCHR
END [PROCEDURE]

PROCEDURE BNOPARSEDATALINE
[* Parse through a line of delimited data and store individual fields into an array
**
**  PASS    BNODATALINE       Line of data to be parsed
**  PASS    BNODLDELIMITER    Field delimiter (defaults to "|" of not set)
**  PASS    BNODLREMOVEPADDING Should trailing and leading padding be removed from each field
**  RETURN  BNODLFIELD        Array of data elements from the parsed BNODATALINE
**  RETURN  BNODLFIELDCOUNT   Number of elements in the BNODLFIELD array
*]

 IF BNODLDELIMITER="" THEN
  BNODLDELIMITER="|"

 BNODLFIELDCOUNT=0
 FOR BNODLINDEX=0 TO BNODLFIELDMAX
  DO
   BNODLFIELD(BNODLINDEX)=""
  END
 WHILE BNODATALINE<>""
  DO
   BNODLPOS=CHARACTERSEARCH(BNODATALINE,BNODLDELIMITER)
   BNODLFIELDCOUNT=BNODLFIELDCOUNT+1
   IF BNODLPOS=0 THEN
    DO
     BNOTEXT=BNODATALINE
     CALL BNONLTS
     BNODLFIELD(BNODLFIELDCOUNT)=BNOTEXT
     BNODATALINE=""
    END
   ELSE
    DO
     BNOTEXT=SEGMENT(BNODATALINE,1,BNODLPOS-1)
     CALL BNONLTS
     BNODLFIELD(BNODLFIELDCOUNT)=BNOTEXT
     BNODATALINE=SEGMENT(BNODATALINE,BNODLPOS+1,LENGTH(BNODATALINE))
    END
  END
 BNODLREMOVEPADDING=FALSE 
END [PROCEDURE]

#INCLUDE "RB.LISTEXPAND"
