 CHRVALBACKSLASH=92
END [DEFINE]

SETUP
 CALL BNOERRINIT

[* Register supported error messages
*] 
 BNOERRCODE=BNOERRCODEMEMOMODE            BNOERRMESSAGE="Program running in memo mode"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODECONFIGREAD          BNOERRMESSAGE="Error opening/reading config file"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODECONFIGVALIDATE      BNOERRMESSAGE="Config file validation error"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODEINELIGACCT          BNOERRMESSAGE="Ineligible Account"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODESUCCESS             BNOERRMESSAGE="Successful Address Update"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODEVALIDATECHGS        BNOERRMESSAGE="Error validating requested changes"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODEPROCESSCHGS         BNOERRMESSAGE="Error processing requested changes"
 CALL BNOERRADD
 BNOERRCODE=BNOERRCODEINVALIDRGDATA       BNOERRMESSAGE="Invalid RG data"
 CALL BNOERRADD

 [* Set any errors that support display messages
 *]
 [BNOERRDISPLAYCODE=BNOERRCODEMEMOMODE
 CALL BNOERRDISPLAYLISTADD]

[* This is where you define all the soft text CFG tags and json properties
**  - Optionally set PARAMMSGMAXLINES to override the default of 20 lines per message
**  - Optionally set PARAMMSGOPT to mark a message as optional. Message will not be returned in
**.   json response if no message lines found in the CFG.
*]
 CALL PARAMMSGINIT
[PARAMMSGTAG="IT"     PARAMMSGPROP="introText"          [Intro Text Message]
 PARAMMSGMAXLINES=10
 CALL PARAMMSGTAGADD]

 CALL SETUPDATA
END [SETUP]

PRINT TITLE=BNOPROGRAMNAME

 CALL INITIALIZEDATA
 CALL GETRGDATA
 CALL TRANSFORMRGDATA

 CALL BNOCFGFILEREAD

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  CALL BNOSETPARAMVALS

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  CALL PARAMPOSTPROCESS

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  CALL VALIDATERGDATA

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  CALL CHECKFORMEMOMODE

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  CALL VALIDATEACCOUNT  

 IF BNOERRORCODE=BNOERRCODESUCCESS AND
    PARAMTESTMODE=TRUE THEN
  BNOERRORCODE=PARAMTESTEC

 IF BNOERRORCODE=BNOERRCODESUCCESS AND PARAMTESTMODE=FALSE THEN
  DO
   IF @RGSTATE=STATEPROCESSADDRCHANGE THEN
    DO
     IF PERFORMMATCHING=TRUE THEN
      DO
       CALL GETNAMELOCSBYMATCH
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL NAMEFMBYLEVEL
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL POSTFMPROCESS  
      END
     ELSE IF RGTARGETEDNAMELOC=0 THEN
      DO
       CALL FINDTRACKING
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL FINDNAME
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL NAMEFM
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL POSTFMPROCESS  
      END
     ELSE
      DO
       CALL GETNAMELOCSBYTARGET
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL NAMEFMBYLEVEL
       IF BNOERRORCODE=BNOERRCODESUCCESS THEN
        CALL POSTFMPROCESS
      END
    END
  END  

[* The Override Conversations parameter allows errors to be handled by sending email with 
** error details vs. sending the member to Conversations in Banno. So the OVERRIDECONVERSATIONS 
** function both resets the error to success and sends error email.
*]      
 IF BNOERRORCODE<>BNOERRCODESUCCESS AND
    PARAMOVERRIDECONVS=TRUE THEN
  CALL OVERRIDECONVERSATIONS

[* Output JSON 
*]
 CALL JSONOPEN
 
 IF @RGSTATE=STATEPROCESSADDRCHANGE THEN
  CALL JSONRESPONSE

 CALL BNOCFGDEBUGADD
 CALL BNOJSONRGDATA
 CALL BNOJSONDEBUGDATA
 IF BNODEBUGMODE=BNODEBUGMODEOFF THEN
  NEWLINE
 
 CALL JSONCLOSE
END [PRINT]

PROCEDURE SETUPDATA
[* Set the SETUP data constants
*]
 PARAMEMAILTYPECHR(EMAILTYPETEXT)="TEXT"
 PARAMEMAILTYPECHR(EMAILTYPEHTML)="HTML"
 
 MATCHNAMELVLCHR(NAMELEVELALL)="ALL"
 MATCHNAMELVLCHR(NAMELEVELACCOUNT)="ACCOUNT"
 MATCHNAMELVLCHR(NAMELEVELSHARE)="SHARE"
 MATCHNAMELVLCHR(NAMELEVELIRS)="IRS"
 MATCHNAMELVLCHR(NAMELEVELLOAN)="LOAN"
 MATCHNAMELVLCHR(NAMELEVELLOANPLEDGE)="PLEDGE"
 MATCHNAMELVLCHR(NAMELEVELEFT)="EFT"
 MATCHNAMELVLCHR(NAMELEVELCARD)="CARD"
 MATCHNAMELVLCHR(NAMELEVELEXTERNAL)="EXTERNAL"

 JSONBOOLEAN(TRUE)="true"
 JSONBOOLEAN(FALSE)="false"
 
[* This is the default state of debug mode.  This may be overridden if the Program Install Date (PID)
** is set in the CFG configuration file.
*] 
 IF BNOLASTMODDATE+BNODEBUGPRINTINFODAYS>SYSTEMDATE THEN
  BNODEBUGMODE=BNODEBUGMODEON
 ELSE 
  BNODEBUGMODE=BNODEBUGMODEOFF 

 SYMXINSTANCE=@SYMXINSTANCEID
 SYMXCLIENTNUM=@CLIENTNUMBER
 BNOIDLENGTH=GETDATANUMBER(GETPARAMIDLENGTH)
 BNOSLTYPELENGTH=GETDATANUMBER(GETPARAMTYPELENGTH)

 QQ=CTRLCHR(CHRVALQUOTE)
 CALL BNOCLEANUPINIT
END [PROCEDURE]

PROCEDURE INITIALIZEDATA
[* Initialize variables
*]

 RGMEMBERNOTESCOUNT=0
 MEMBEREMAIL=NAME:EMAIL
 PERFORMMATCHING=FALSE
 MATCHNMTYPESSET=FALSE
 NAMECOUNT=0
 PREFLOC=@PREFLOCATOR
 ADDNOTETEXTCOUNT=0
 ADDNOTESORTEDCOUNT=0
 ADDNOTETYPEADD=ADDNOTETYPEGENERAL
 ADDNOTEHEADER=""
 FOR TMPLOOP=1 TO ADDNOTETEXTMAX
  DO
   ADDNOTETEXT(TMPLOOP)=""
   ADDNOTETYPE(TMPLOOP)=ADDNOTETYPEGENERAL
   ADDNOTESORTED(TMPLOOP)=""
  END

 BNOERRORCODE=BNOERRCODESUCCESS
 BNOERRORMODIFIER=""
 BNOCFGPARAMALLOWDUPS=FALSE
 JSONOBJFIRSTPROP=TRUE
 BNODLDELIMITER=""
 BNODLREMOVEPADDING=FALSE
 MSGPROPSELECTLIST=""
 MSGTAGSELECT=""
END [PROCEDURE]

PROCEDURE GETRGDATA
[* Read in the @RG values from the UX, segment them into their individual
** values.
*]
 RGLANGUAGE=@RGSESSION
 IF @RGSTATE=STATEPROCESSADDRCHANGE THEN
  DO
   RGNEWADDRLINE1=@RGUSERCHR1
   RGNEWADDRLINE2=@RGUSERCHR2 
   RGMEMBERNOTE=SEGMENT(@RGUSERCHR3,1,130)
   IF RGMEMBERNOTE<>"" THEN
    DO
     BNOTEXT=RGMEMBERNOTE
     CALL BNOCLEANUPTEXT
     RGMEMBERNOTE=BNOTEXT
    END

   RGCURRBANNOID=@RGUSERCHR4
   RGTARGETEDNAMELOC=@RGUSERNUM1
  END
END [PROCEDURE]

PROCEDURE VALIDATERGDATA
[* Check the member's new street address to see if it contains PO Box address per the CU's configuration settings. If a
** PO Box address is found, set an error code and create a note record on the member's account. Also validates RGNEWSTREET,
** RGNEWCITY, RGNEWSTATE and RGNEWZIPCODE are completed.  
**
** PASS    RGNEWSTREET
** PASS    RGNEWCITY
** PASS    RGNEWSTATE
** PASS    RGNEWZIPCODE
** PASS    PARAMPORESTRICT   (Boolean) Should the street be checked for a PO Box address
** RETURN  BNOERRORCODE
** RETURN  BNOERRORMODIFIER
*]
 IF @RGSTATE=STATEPROCESSADDRCHANGE THEN
  DO
   IF RGNEWSTREET="" OR RGNEWCITY="" OR RGNEWSTATE="" OR RGNEWZIPCODE="" THEN
    DO
     BNOERRORCODE=BNOERRCODEVALIDATECHGS
     BNOERRORMODIFIER=BNOERRMODMISSINGDATA
     ADDNOTETEXTADD=BNOERRORMODIFIER
     CALL ADDNOTEADD
    END

   IF LENGTH(RGNEWSTREET)>40 OR
      LENGTH(RGNEWEXTRAADDR)>40 OR
      LENGTH(RGNEWCITY)>40 OR
      LENGTH(RGNEWSTATE)>10 OR
      LENGTH(RGNEWZIPCODE)>10 OR
     (LENGTH(RGNEWCITY)+LENGTH(RGNEWSTATE)+LENGTH(RGNEWZIPCODE)>38) THEN
    DO
     BNOERRORCODE=BNOERRCODEVALIDATECHGS
     BNOERRORMODIFIER=BNOERRMODENTRYLIMIT
     ADDNOTETEXTADD=BNOERRORMODIFIER
     CALL ADDNOTEADD
    END

   IF BNOERRORCODE=BNOERRCODESUCCESS AND
      PARAMPORESTRICT=TRUE THEN
    DO
     POBOXFOUND=FALSE
     TMPLOOP=1
     WHILE TMPLOOP<=PARAMPOBOXLISTMAX AND
           POBOXFOUND=FALSE
      DO
       IF CHARACTERSEARCH(RGNEWSTREET,UPPERCASE(PARAMPOBOXLIST(TMPLOOP)))>0 THEN
        POBOXFOUND=TRUE
       TMPLOOP=TMPLOOP+1
      END     
  
     IF POBOXFOUND=TRUE THEN
      DO
       BNOERRORCODE=BNOERRCODEVALIDATECHGS
       BNOERRORMODIFIER=BNOERRMODPOBOX
       ADDNOTETEXTADD=BNOERRORMODIFIER
       CALL ADDNOTEADD
      END
    END

   IF BNOERRORCODE<>BNOERRCODESUCCESS THEN
    CALL ADDNOTECREATE 
  END
END [PROCEDURE]

PROCEDURE TRANSFORMRGDATA
[* Take the GETRGDATA data and transform further into components
** 
*]

 IF @RGSTATE=STATEPROCESSADDRCHANGE THEN
  DO
   BNODLDELIMITER="|"

[* street, extra address
*]
   BNODLREMOVEPADDING=TRUE
   BNODATALINE=RGNEWADDRLINE1
   CALL BNOPARSEDATALINE
   IF BNODLFIELDCOUNT>2 THEN
    BNOERRORCODE=BNOERRCODEINVALIDRGDATA
   ELSE
    DO
     RGNEWSTREET=BNODLFIELD(1)
     RGNEWEXTRAADDR=BNODLFIELD(2)
    END

[* city, state & zipcode
*]
   BNODLREMOVEPADDING=TRUE
   BNODATALINE=RGNEWADDRLINE2
   CALL BNOPARSEDATALINE
   IF BNODLFIELDCOUNT>3 THEN
    BNOERRORCODE=BNOERRCODEINVALIDRGDATA
   ELSE
    DO
     RGNEWCITY=BNODLFIELD(1)
     RGNEWSTATE=BNODLFIELD(2)
     RGNEWZIPCODE=BNODLFIELD(3)
    END

[* member note
*]
   BNODLREMOVEPADDING=TRUE
   BNODATALINE=RGMEMBERNOTE
   CALL BNOPARSEDATALINE
   PARSETEXTRAW=BNODLFIELD(1)
   CALL PARSEMEMBERNOTE

[* member Banno ID
*]
   BNODLREMOVEPADDING=TRUE
   BNODATALINE=RGCURRBANNOID
   CALL BNOPARSEDATALINE
   RGCURRBANNOID=UPPERCASE(BNODLFIELD(1))
  END
END [PROCEDURE]

PROCEDURE PARSEMEMBERNOTE
[* Parse through a single text variable with a max length of 130 characters and output member note text lines to add. 
** Procedure will create a segment break at the first space found prior to the max segment length. If no space is 
** found, the entire segment length will be stored into the array.
**
**   PASS   PARSETEXTRAW       The original text string
*]

 WHILE PARSETEXTRAW<>""
  DO
   IF LENGTH(PARSETEXTRAW)<=ADDNOTELINEMAX THEN
    DO
     ADDNOTETEXTADD=PARSETEXTRAW
     ADDNOTETYPEADD=ADDNOTETYPEMBRNOTE
     CALL ADDNOTEADD
     PARSETEXTRAW=""

     RGMEMBERNOTESCOUNT=RGMEMBERNOTESCOUNT+1
     RGMEMBERNOTES(RGMEMBERNOTESCOUNT)=ADDNOTETEXTADD
    END
   ELSE
    DO
     POS=ADDNOTELINEMAX
     FOUND=FALSE
     WHILE (FOUND=FALSE AND POS>0)
      DO
       IF SEGMENT(PARSETEXTRAW,POS,POS)=" " THEN
        FOUND=TRUE
       ELSE
        POS=POS-1
      END
     IF FOUND=FALSE THEN
      DO [no space found in first 40 characters - grab first 40 characters]
       ADDNOTETEXTADD=SEGMENT(PARSETEXTRAW,1,ADDNOTELINEMAX)
       ADDNOTETYPEADD=ADDNOTETYPEMBRNOTE
       CALL ADDNOTEADD
       PARSETEXTRAW=SEGMENT(PARSETEXTRAW,ADDNOTELINEMAX+1,LENGTH(PARSETEXTRAW))

       RGMEMBERNOTESCOUNT=RGMEMBERNOTESCOUNT+1
       RGMEMBERNOTES(RGMEMBERNOTESCOUNT)=ADDNOTETEXTADD
      END
     ELSE
      DO [space found. grab chars 1 through space-1, leave remaining]
       ADDNOTETEXTADD=SEGMENT(PARSETEXTRAW,1,POS-1)
       ADDNOTETYPEADD=ADDNOTETYPEMBRNOTE
       CALL ADDNOTEADD
       PARSETEXTRAW=SEGMENT(PARSETEXTRAW,POS+1,LENGTH(PARSETEXTRAW))

       RGMEMBERNOTESCOUNT=RGMEMBERNOTESCOUNT+1
       RGMEMBERNOTES(RGMEMBERNOTESCOUNT)=ADDNOTETEXTADD
      END
    END
  END
END [PROCEDURE]

PROCEDURE CHECKFORMEMOMODE

 IF PARAMALLOWINMEMOMODE=FALSE AND 
    SYSMEMOMODE=TRUE THEN
  DO
   BNOERRORCODE=BNOERRCODEMEMOMODE
   ADDNOTETEXTADD="Banno Chg addr err: System in Memo Mode"
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END  
END

PROCEDURE GETNAMELOCSBYMATCH
[* Collects name locators and associated identifying information for allowed name types and levels. Only
** called if old address matching is enabled.
*]

 FOR EACH NAME WITH (NAME:TYPE=0)
  DO
   OLDSTREET=NAME:STREET
   OLDEXTRA=NAME:EXTRAADDRESS
   OLDCITY=NAME:CITY
   OLDSTATE=NAME:STATE
   OLDZIP=SEGMENT(NAME:ZIPCODE,1,5)
  END

 IF PARAMMATCHNAMELVL(NAMELEVELACCOUNT)=TRUE THEN
  DO
   FOR EACH NAME WITH ((NAME:EXPIRATIONDATE=DATENULL OR
                        NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                        NAME:DEATHDATE=DATENULL AND
                        PARAMMATCHNMTYPES(NAME:TYPE)=TRUE AND
                        NAME:STREET=OLDSTREET AND
                        NAME:EXTRAADDRESS=OLDEXTRA AND
                        NAME:CITY=OLDCITY AND
                        NAME:STATE=OLDSTATE AND
                        SEGMENT(NAME:ZIPCODE,1,5)=OLDZIP)
    DO
     THISLEVEL=NAMELEVELACCOUNT
     THISLOCATOR=NAME:LOCATOR
     CALL ADDNAMEFMLIST
    END
  END

 IF PARAMMATCHNAMELVL(NAMELEVELSHARE)=TRUE THEN
  DO
   FOR EACH SHARE WITH (SHARE:CLOSEDATE=DATENULL)
    DO
     FOR EACH SHARE NAME WITH ((SHARE NAME:EXPIRATIONDATE=DATENULL OR
                                SHARE NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                                SHARE NAME:DEATHDATE=DATENULL AND
                                PARAMMATCHNMTYPES(SHARE NAME:TYPE)=TRUE AND
                                SHARE NAME:STREET=OLDSTREET AND
                                SHARE NAME:EXTRAADDRESS=OLDEXTRA AND
                                SHARE NAME:CITY=OLDCITY AND
                                SHARE NAME:STATE=OLDSTATE AND
                                SEGMENT(SHARE NAME:ZIPCODE,1,5)=OLDZIP)
      DO
       THISLEVEL=NAMELEVELSHARE
       THISLOCATOR=SHARE NAME:LOCATOR
       THISSLID=SHARE:ID
       CALL ADDNAMEFMLIST
      END
    END
  END

 IF PARAMMATCHNAMELVL(NAMELEVELIRS)=TRUE THEN
  DO
   FOR EACH IRS
    DO
     FOR EACH IRS NAME WITH ((IRS NAME:EXPIRATIONDATE=DATENULL OR
                              IRS NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                              IRS NAME:DEATHDATE=DATENULL AND
                              PARAMMATCHNMTYPES(IRS NAME:TYPE)=TRUE AND
                              IRS NAME:STREET=OLDSTREET AND
                              IRS NAME:EXTRAADDRESS=OLDEXTRA AND
                              IRS NAME:CITY=OLDCITY AND
                              IRS NAME:STATE=OLDSTATE AND
                              SEGMENT(IRS NAME:ZIPCODE,1,5)=OLDZIP)
      DO
       THISLEVEL=NAMELEVELIRS
       THISLOCATOR=IRS NAME:LOCATOR
       THISPATHLOCATOR=IRS:LOCATOR
       CALL ADDNAMEFMLIST
      END
    END
  END

 IF PARAMMATCHNAMELVL(NAMELEVELLOAN)=TRUE OR
    PARAMMATCHNAMELVL(NAMELEVELLOANPLEDGE)=TRUE THEN
  DO
   FOR EACH LOAN WITH (LOAN:CLOSEDATE=DATENULL)
    DO
     IF PARAMMATCHNAMELVL(NAMELEVELLOAN)=TRUE THEN
      DO
       FOR EACH LOAN NAME WITH ((LOAN NAME:EXPIRATIONDATE=DATENULL OR
                                 LOAN NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                                 LOAN NAME:DEATHDATE=DATENULL AND
                                 PARAMMATCHNMTYPES(LOAN NAME:TYPE)=TRUE AND
                                 LOAN NAME:STREET=OLDSTREET AND
                                 LOAN NAME:EXTRAADDRESS=OLDEXTRA AND
                                 LOAN NAME:CITY=OLDCITY AND
                                 LOAN NAME:STATE=OLDSTATE AND
                                 SEGMENT(LOAN NAME:ZIPCODE,1,5)=OLDZIP)
        DO
         THISLEVEL=NAMELEVELLOAN
         THISLOCATOR=LOAN NAME:LOCATOR
         THISSLID=LOAN:ID
         CALL ADDNAMEFMLIST
        END
      END
     IF PARAMMATCHNAMELVL(NAMELEVELLOANPLEDGE)=TRUE THEN
      DO
       FOR EACH LOAN PLEDGE
        DO
         FOR EACH LOAN PLEDGE NAME WITH ((LOAN PLEDGE NAME:EXPIRATIONDATE=DATENULL OR
                                          LOAN PLEDGE NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                                          LOAN PLEDGE NAME:DEATHDATE=DATENULL AND
                                          PARAMMATCHNMTYPES(LOAN PLEDGE NAME:TYPE)=TRUE AND
                                          LOAN PLEDGE NAME:STREET=OLDSTREET AND
                                          LOAN PLEDGE NAME:EXTRAADDRESS=OLDEXTRA AND
                                          LOAN PLEDGE NAME:CITY=OLDCITY AND
                                          LOAN PLEDGE NAME:STATE=OLDSTATE AND
                                          SEGMENT(LOAN PLEDGE NAME:ZIPCODE,1,5)=OLDZIP)
          DO
           THISLEVEL=NAMELEVELLOANPLEDGE
           THISLOCATOR=LOAN PLEDGE NAME:LOCATOR
           THISPATHLOCATOR=LOAN PLEDGE:LOCATOR
           THISSLID=LOAN:ID
           CALL ADDNAMEFMLIST
          END
        END
      END
    END
  END

 IF PARAMMATCHNAMELVL(NAMELEVELEFT)=TRUE THEN
  DO
   FOR EACH EFT WITH (EFT:EXPIRATIONDATE>SYSTEMDATE OR
                      EFT:EXPIRATIONDATE=DATENULL)
    DO
     FOR EACH EFT NAME WITH ((EFT NAME:EXPIRATIONDATE=DATENULL OR
                              EFT NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                              EFT NAME:DEATHDATE=DATENULL AND
                              PARAMMATCHNMTYPES(EFT NAME:TYPE)=TRUE AND
                              EFT NAME:STREET=OLDSTREET AND
                              EFT NAME:EXTRAADDRESS=OLDEXTRA AND
                              EFT NAME:CITY=OLDCITY AND
                              EFT NAME:STATE=OLDSTATE AND
                              SEGMENT(EFT NAME:ZIPCODE,1,5)=OLDZIP)
      DO
       THISLEVEL=NAMELEVELEFT
       THISLOCATOR=EFT NAME:LOCATOR
       THISPATHLOCATOR=EFT:LOCATOR
       CALL ADDNAMEFMLIST
      END
    END
  END
 
 IF PARAMMATCHNAMELVL(NAMELEVELCARD)=TRUE THEN
  DO
   FOR EACH CARD WITH (CARD:EXPIRATIONDATE>SYSTEMDATE AND
                       CARD:STATUS<>2 AND
                       CARD:CLOSEDATE=DATENULL)
    DO
     FOR EACH CARD NAME WITH ((CARD NAME:EXPIRATIONDATE=DATENULL OR
                               CARD NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                               CARD NAME:DEATHDATE=DATENULL AND
                               PARAMMATCHNMTYPES(CARD NAME:TYPE)=TRUE AND
                               CARD NAME:STREET=OLDSTREET AND
                               CARD NAME:EXTRAADDRESS=OLDEXTRA AND
                               CARD NAME:CITY=OLDCITY AND
                               CARD NAME:STATE=OLDSTATE AND
                               SEGMENT(CARD NAME:ZIPCODE,1,5)=OLDZIP)
      DO
       THISLEVEL=NAMELEVELCARD
       THISLOCATOR=CARD NAME:LOCATOR
       THISPATHLOCATOR=CARD:LOCATOR
       CALL ADDNAMEFMLIST
      END
    END
  END
 
 IF PARAMMATCHNAMELVL(NAMELEVELEXTERNAL)=TRUE THEN
  DO
   FOR EACH EXTERNALLOAN WITH (EXTERNALLOAN:CLOSEDATE=DATENULL)
    DO
     FOR EACH EXTERNALLOAN NAME WITH ((EXTERNALLOAN NAME:EXPIRATIONDATE=DATENULL OR
                                       EXTERNALLOAN NAME:EXPIRATIONDATE>SYSTEMDATE) AND
                                       EXTERNALLOAN NAME:DEATHDATE=DATENULL AND
                                       PARAMMATCHNMTYPES(EXTERNALLOAN NAME:TYPE)=TRUE AND
                                       EXTERNALLOAN NAME:STREET=OLDSTREET AND
                                       EXTERNALLOAN NAME:EXTRAADDRESS=OLDEXTRA AND
                                       EXTERNALLOAN NAME:CITY=OLDCITY AND
                                       EXTERNALLOAN NAME:STATE=OLDSTATE AND
                                       SEGMENT(EXTERNALLOAN NAME:ZIPCODE,1,5)=OLDZIP)
      DO
       THISLEVEL=NAMELEVELEXTERNAL
       THISLOCATOR=EXTERNALLOAN NAME:LOCATOR
       THISPATHLOCATOR=EXTERNALLOAN:LOCATOR
       CALL ADDNAMEFMLIST
      END
    END
  END

 IF NAMECOUNT=0 THEN
  DO
   BNOERRORCODE=BNOERRCODEVALIDATECHGS
   BNOERRORMODIFIER=BNOERRMODNOALLOWEDNAMES
   ADDNOTETEXTADD=BNOERRMODNOALLOWEDNAMES
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END
END [PROCEDURE]

PROCEDURE GETNAMELOCSBYTARGET

 THISLOCATOR=RGTARGETEDNAMELOC
 THISLEVEL=NAMELEVELNONE

[* Look in the account level
*]
 FOR EACH NAME WITH (NAME:LOCATOR=RGTARGETEDNAMELOC)
  DO
   THISLEVEL=NAMELEVELACCOUNT
   CALL ADDNAMEFMLIST
  END
 UNTIL THISLEVEL<>NAMELEVELNONE
 
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the share level
*]
   FOR EACH SHARE
    DO
     FOR EACH SHARE NAME WITH(SHARE NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELSHARE
       THISSLID=SHARE:ID
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
    END
   UNTIL THISLEVEL<>NAMELEVELNONE
  END
  
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the IRS level
*]
   FOR EACH IRS
    DO
     FOR EACH IRS NAME WITH(IRS NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELIRS
       THISPATHLOCATOR=IRS:LOCATOR
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
    END
   UNTIL THISLEVEL<>NAMELEVELNONE
  END
 
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the loan level
*]
   FOR EACH LOAN
    DO
     FOR EACH LOAN NAME WITH(LOAN NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELLOAN
       THISSLID=LOAN:ID
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
     
     IF THISLEVEL=NAMELEVELNONE THEN
      DO
[* Look in the loan pledge level
*]
       FOR EACH LOAN PLEDGE
        DO
         FOR EACH LOAN PLEDGE NAME WITH(LOAN PLEDGE NAME:LOCATOR=RGTARGETEDNAMELOC)
          DO
           THISLEVEL=NAMELEVELLOANPLEDGE
           THISPATHLOCATOR=LOAN PLEDGE:LOCATOR
           THISSLID=LOAN:ID
           CALL ADDNAMEFMLIST   
          END 
         UNTIL THISLEVEL<>NAMELEVELNONE
        END
       UNTIL THISLEVEL<>NAMELEVELNONE
      END
    END
   UNTIL THISLEVEL<>NAMELEVELNONE
  END
 
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the EFT level
*]
   FOR EACH EFT
    DO
     FOR EACH EFT NAME WITH(EFT NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELEFT
       THISPATHLOCATOR=EFT:LOCATOR
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
    END
   UNTIL THISLEVEL<>NAMELEVELNONE
  END
 
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the card level
*]
   FOR EACH CARD
    DO
     FOR EACH CARD NAME WITH(CARD NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELCARD
       THISPATHLOCATOR=CARD:LOCATOR
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
    END
   UNTIL THISLEVEL<>NAMELEVELNONE
  END
 
 IF THISLEVEL=NAMELEVELNONE THEN
  DO
[* Look in the external loan level
*]
   FOR EACH EXTERNALLOAN
    DO
     FOR EACH EXTERNALLOAN NAME WITH(EXTERNALLOAN NAME:LOCATOR=RGTARGETEDNAMELOC)
      DO
       THISLEVEL=NAMELEVELEXTERNAL
       THISPATHLOCATOR=EXTERNALLOAN:LOCATOR
       CALL ADDNAMEFMLIST
      END
     UNTIL THISLEVEL<>NAMELEVELNONE
    END 
   UNTIL THISLEVEL<>NAMELEVELNONE
  END

 IF THISLEVEL=NAMELEVELNONE THEN
  DO
   BNONUM=RGTARGETEDNAMELOC
   CALL BNONUMTEXT
   BNOERRORCODE=BNOERRCODEVALIDATECHGS
   BNOERRORMODIFIER=BNOERRMODTARGETNOTFOUND
   BNOERRORMODIFIER="Targeted name LOC "+BNOTEXT+" not found"

   ADDNOTETEXTADD=BNOERRORMODIFIER
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END
END

PROCEDURE ADDNAMEFMLIST

 IF NAMECOUNT<NAMESMAX THEN
  DO
   NAMECOUNT=NAMECOUNT+1
   NAMELOCATORS(NAMECOUNT)=THISLOCATOR
   NAMEPATHLOCATORS(NAMECOUNT)=THISPATHLOCATOR
   NAMESLIDS(NAMECOUNT)=THISSLID
   NAMELEVELS(NAMECOUNT)=THISLEVEL
  END

 THISPATHLOCATOR=0
 THISSLID=""
END [PROCEDURE]

PROCEDURE MSGPROPSELECTADD
[* Call before JSONMSGARRAYS to selectively output soft text/message properties.
** This may be called multiple times with different MSGPROPSELECT values to select and output
** multiple soft text properties. MSGTAGSELECT can be set if multiple message tags point to a
** single message property and a specific message tag/property is being output.  JSONMSGARRAYS 
** will output all defined soft text message if this procedure is not called prior to JSONMSGARRAYS.
** Example:
**
**  MSGPROPSELECT="informationMsg"
**  CALL MSGPROPSELECTADD
**  CALL JSONMSGARRAYS
**
**  PASS    MSGPROPSELECT      The json property name for soft text that should be selected
**  PASS    MSGTAGSELECT       The CFG tag name for soft text that should be selected (**optional**)
**  
**  RETURN  MSGPROPSELECTLIST  Updated list
*]

 IF MSGPROPSELECTLIST<>"" THEN
  MSGPROPSELECTLIST=MSGPROPSELECTLIST+","
 MSGPROPSELECTLIST=MSGPROPSELECTLIST+MSGPROPSELECT
 IF MSGTAGSELECT<>"" THEN
  MSGPROPSELECTLIST=MSGPROPSELECTLIST+":"+MSGTAGSELECT
 MSGTAGSELECT=""
END

PROCEDURE GETUSELANGUAGE
 
 USELANGUAGE=PARAMMSGTAGENGLISH
 IF PARAMLANGSPANISH=TRUE THEN
  USELANGUAGE=RGLANGUAGE
END [PROCEDURE]

PROCEDURE VALIDATEACCOUNT
[* Validate the member's account for account type and/or warning code(s). If a targeted warning or account type is found, an
** error code wil be returned and a note record created on the member's account.
**
*]
 IF PARAMINELIGACCTTYPES(ACCOUNT:TYPE)=TRUE THEN
  DO
   BNOERRORCODE=BNOERRCODEINELIGACCT
   BNOERRORMODIFIER=BNOERRMODACCTTYPE
   BNOERRORMODIFIER="Acct Type "+FORMAT("9999",ACCOUNT:TYPE)

   ADDNOTETEXTADD=FORMAT("Invalid Acct Type:9999",ACCOUNT:TYPE)
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END

 IF BNOERRORCODE=BNOERRCODESUCCESS THEN
  DO
   TMPLOOP=1
   WHILE TMPLOOP<=ACCTWARNINGSMAX AND BNOERRORCODE=BNOERRCODESUCCESS
    DO
     IF ANYWARNING(ACCOUNT,TMPLOOP) AND
        PARAMWARNINGSACCT(TMPLOOP)=TRUE THEN
      DO
       BNOERRORCODE=BNOERRCODEINELIGACCT
       BNOERRORMODIFIER=BNOERRMODACCTWARN
       BNOERRORMODIFIER="Acct Warning "+FORMAT("9999",TMPLOOP)

       ADDNOTETEXTADD=FORMAT("Invalid Acct Warn:999",TMPLOOP)
       CALL ADDNOTEADD
       CALL ADDNOTECREATE
      END  

     TMPLOOP=TMPLOOP+1
    END
  END
END [PROCEDURE]

PROCEDURE FINDTRACKING
[* Find the tracking 8 record which contains the member's Banno ID and
** retrieve the member's address link number.
**
** PASS    PREFLOC         Preference record locator of member
** RETURN  MEMBERADDRLINK  Targeted member's address number link
*]
 BNOTEXT=FORMAT("#########9",PREFLOC)
 CALL BNONLTS
 TRACKINGFOUND=FALSE
 MEMBERADDRLINK=""
 FOR EACH TRACKING WITH (TRACKINGFOUND=FALSE AND
                       ((TRACKING:EXPIREDATE=DATENULL OR
                         TRACKING:EXPIREDATE>SYSTEMDATE) AND
                         TRACKING:USERCHAR12=BNOTEXT AND
                         UPPERCASE(TRACKING:USERCHAR13)=RGCURRBANNOID))
  DO
   TRACKINGFOUND=TRUE
   MEMBERADDRLINK=TRACKING:USERCHAR15
  END

 IF TRACKINGFOUND=FALSE THEN
  DO
   BNOERRORCODE=BNOERRCODEVALIDATECHGS
   BNOERRORMODIFIER=BNOERRMODTRK8
  END
 ELSE IF MEMBERADDRLINK="" THEN
  DO
   BNOERRORCODE=BNOERRCODEVALIDATECHGS
   BNOERRORMODIFIER=BNOERRMODTRK8NOLINK
  END

 IF BNOERRORCODE<>0 THEN
  DO
   ADDNOTETEXTADD=BNOERRORMODIFIER
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END 
END [PROCEDURE]

PROCEDURE FINDNAME

 NAMELOC=0
 FOR EACH NAME WITH (NAME:MBRADDRNUMLINK=MEMBERADDRLINK)
  DO
   NAMELOC=NAME:LOCATOR
  END
 
 IF NAMELOC=0 THEN
  DO
   BNOERRORCODE=BNOERRCODEPROCESSCHGS
   BNOERRORMODIFIER=BNOERRMODLOCATENAME
   BNOERRORMODIFIER=FORMAT("Could not locate name LOC ####9",NAMELOC)

   ADDNOTETEXTADD=FORMAT("Could not locate Name LOC ####9 ",NAMELOC)
   CALL ADDNOTEADD
   CALL ADDNOTECREATE
  END
END [PROCEDURE]

PROCEDURE OVERRIDECONVERSATIONS
[* If conversations override is enabled, this procedure sends an email to the specified CU email address, adds
** address information to the account note, and overrides response code to 504 (successful address change) so the
** UX does not open a conversation in Banno People.
*]
 
 CALL BNOERRGETMESSAGE
 ERRORDETAIL=BNOERRMESSAGE
 IF BNOERRMODIFIER<>"" THEN
  ERRORDETAIL=ERRORDETAIL+": "+BNOERRMODIFIER
 
 EMAILSENDERROR=""
 EMAILSTART(PARAMOVERRIDEEMAIL,PARAMOVERRIDEEMAIL,"Banno Address Change - Intervention Needed",EMAILSENDERROR)
 IF EMAILSENDERROR="" THEN
  DO
   EMAILLINE("MIME-Version: 1.0",EMAILSENDERROR)
   EMAILLINE("Content-Type: text/html; charset=us-ascii",EMAILSENDERROR)
   EMAILLINE("",EMAILSENDERROR)
   EMAILLINE("The following account attempted a Banno address change but there was an error, ",EMAILSENDERROR)
   EMAILLINE("manual intervention is needed :",EMAILSENDERROR)
   EMAILLINE("<br /><br />",EMAILSENDERROR)
   EMAILLINE("Account : xxxxxx"+SEGMENT(ACCOUNT:NUMBER,7,10)+" "+NAME:SHORTNAME,EMAILSENDERROR)
   EMAILLINE("<br />",EMAILSENDERROR)
   EMAILLINE("Error Code : "+FORMAT("999",BNOERRCODE),EMAILSENDERROR)
   EMAILLINE("<br />",EMAILSENDERROR)
   EMAILLINE("Error Detail : "+ERRORDETAIL,EMAILSENDERROR)
   EMAILLINE("<br /><br />",EMAILSENDERROR)
   EMAILLINE("New address information can be found in the account notes.",EMAILSENDERROR)
   EMAILLINE("<br />",EMAILSENDERROR)
   EMAILSEND(EMAILSENDERROR)
  END

 BNOERRORCODE=BNOERRCODESUCCESS
 IF EMAILSENDERROR<>"" THEN
  DO
   BNOERRORMODIFIER=BNOERRMODOVREMAILERROR
   BNOERRORMODIFIER="Override email error - "+EMAILSENDERROR
  END 
 ELSE
  DO
   BNOERRORMODIFIER=BNOERRMODOVREMAILSENT
   BNOERRORMODIFIER="Conversations override email sent to "+PARAMOVERRIDEEMAIL
  END 
END [PROCEDURE]

[*
**  --------------------------------------------------------------------
**  File Maintenance Procedures
**  --------------------------------------------------------------------
*]

PROCEDURE ADDADDRDETAILSNOTE
[* If conversations override is enabled, this procedure adds account level note with the new address information.
*]
 FOR TMPLOOP=1 TO ADDRDETAILMAX
  DO
   ADDRDETAILTEXT(TMPLOOP)=""
  END

 IF RGNEWSTREET<>"" OR RGNEWEXTRAADDR<>"" OR
    RGNEWCITY<>"" OR RGNEWSTATE<>"" OR
    RGNEWZIPCODE<>"" THEN
  DO
   ADDRDETAILTEXT(1)="New address details:"
   ADDRDETAILTEXT(2)=UPPERCASE(RGNEWSTREET)
   IF RGNEWEXTRAADDR="" THEN
    ADDRDETAILTEXT(3)=UPPERCASE(RGNEWCITY)+", "+UPPERCASE(RGNEWSTATE)+" "+UPPERCASE(RGNEWZIPCODE)
   ELSE
    DO
     ADDRDETAILTEXT(3)=UPPERCASE(RGNEWEXTRAADDR)
     ADDRDETAILTEXT(4)=UPPERCASE(RGNEWCITY)+", "+UPPERCASE(RGNEWSTATE)+" "+UPPERCASE(RGNEWZIPCODE)
    END
  END

 FMPERFORM CREATE NOTE LOC BEFOREFIRST (0,0,NEWLOC,FMERROR)
  DO
   SET TEXT:1 TO ADDRDETAILTEXT(1)
   SET TEXT:2 TO ADDRDETAILTEXT(2)
   SET TEXT:3 TO ADDRDETAILTEXT(3)
   SET TEXT:4 TO ADDRDETAILTEXT(4)
   SET EXPIRATIONDATE TO SYSTEMDATE+NOTEEXPIREDAYS
  END
END [PROCEDURE]

PROCEDURE NAMEFM

 FMPERFORM REVISE NAME LOC NAMELOC (0,0,FMERROR)
  DO
   SET EXTRAADDRESS TO UPPERCASE(RGNEWEXTRAADDR)
   SET STREET TO UPPERCASE(RGNEWSTREET)
   SET CITY TO UPPERCASE(RGNEWCITY)
   SET STATE TO UPPERCASE(RGNEWSTATE)
   SET ZIPCODE TO UPPERCASE(RGNEWZIPCODE)
  END

 BNONUM=NAMELOC
 CALL BNONUMTEXT
 LOCATORCHR=BNOTEXT
 IF FMERROR="" THEN
  DO
   BNOERRORMODIFIER=BNOERRMODSUCCESSLOC
   BNOERRORMODIFIER="Name LOC "+LOCATORCHR
   
   ADDNOTETEXTADD="Acct Name LOC "+LOCATORCHR+" Updated"
   CALL ADDNOTEADD
  END
 ELSE 
  DO
   BNOERRORCODE=BNOERRCODEPROCESSCHGS
   BNOERRORMODIFIER=BNOERRMODNAMEFM
   BNOERRORMODIFIER="Name FM - "+FMERROR
   
   ADDNOTETEXTADD="Acct Name LOC "+LOCATORCHR
   CALL ADDNOTEADD
   ADDNOTETEXTADD="FM - "+FMERROR
   CALL ADDNOTEADD

   CALL ADDNOTECREATE
  END
END [PROCEDURE]

PROCEDURE NAMEFMBYLEVEL
[* Performs file maintenance on all selected name records and allowed name levels. Only called when
** old address matching is enabled.
*]

 CALL NAMEFMBYACCOUNT
 CALL NAMEFMBYSHARE
 CALL NAMEFMBYIRS
 CALL NAMEFMBYLOAN
 CALL NAMEFMBYLOANPLEDGE
 CALL NAMEFMBYEFT
 CALL NAMEFMBYCARD
 CALL NAMEFMBYEXTERNAL

 IF BNOERRORCODE<>BNOERRCODESUCCESS THEN
  DO
   ADDNOTEHEADER="Banno Address Change ERROR"
   CALL ADDNOTECREATE
  END
 ELSE
  DO
   IF PERFORMMATCHING=TRUE THEN
    DO
     BNONUM=NAMECOUNT
     CALL BNONUMTEXT
     BNOERRORMODIFIER=BNOERRMODSUCCESSNUM
     BNOERRORMODIFIER=BNOTEXT+" Name Record"
     IF NAMECOUNT>1 THEN
      BNOERRORMODIFIER=BNOERRORMODIFIER+"s"
    END
   ELSE
    DO
     BNONUM=RGTARGETEDNAMELOC
     CALL BNONUMTEXT
     BNOERRORMODIFIER=BNOERRMODSUCCESSLOC
     BNOERRORMODIFIER="Name LOC "+BNOTEXT
    END   
  END 
END [PROCEDURE]

PROCEDURE NAMEFMBYACCOUNT

[ Account level name FM]

 TMPLOOP=1
 WHILE TMPLOOP<=NAMECOUNT
  DO
   LEVELCHR=MATCHNAMELVLCHR(NAMELEVELS(TMPLOOP))
   BNONUM=NAMELOCATORS(TMPLOOP)
   CALL BNONUMTEXT
   LOCATORCHR=BNOTEXT

   IF NAMELEVELS(TMPLOOP)=NAMELEVELACCOUNT AND
      BNOERRORCODE=BNOERRCODESUCCESS THEN
    DO
     FMPERFORM REVISE NAME LOC NAMELOCATORS(TMPLOOP)(0,0,FMERROR)
      DO
       SET EXTRAADDRESS TO UPPERCASE(RGNEWEXTRAADDR)
       SET STREET TO UPPERCASE(RGNEWSTREET)
       SET CITY TO UPPERCASE(RGNEWCITY)
       SET STATE TO UPPERCASE(RGNEWSTATE)
       SET ZIPCODE TO UPPERCASE(RGNEWZIPCODE)
      END
     CALL HANDLEFMERROR 
    END
   ELSE IF NAMELEVELS(TMPLOOP)=NAMELEVELACCOUNT THEN
    DO
[* Add note when an error already occurred -- fm being skipped on this record
*]    
     ADDNOTETEXTADD=LEVELCHR+" Name LOC "+LOCATORCHR+" NOT UPDATED"
     CALL ADDNOTEADD
    END

   TMPLOOP=TMPLOOP+1
  END
END [PROCEDURE]

PROCEDURE NAMEFMBYSHARE

 TMPLOOP=1
 WHILE TMPLOOP<=NAMECOUNT
  DO
   LEVELCHR=MATCHNAMELVLCHR(NAMELEVELS(TMPLOOP))
   BNONUM=NAMELOCATORS(TMPLOOP)
   CALL BNONUMTEXT
   LOCATORCHR=BNOTEXT

   IF NAMELEVELS(TMPLOOP)=NAMELEVELSHARE AND
      BNOERRORCODE=BNOERRCODESUCCESS THEN
    DO
     FMPERFORM REVISE SHARE NAMESLIDS(TMPLOOP) NAME LOC NAMELOCATORS(TMPLOOP)(0,0,FMERROR)
      DO
       SET EXTRAADDRESS TO UPPERCASE(RGNEWEXTRAADDR)
       SET STREET TO UPPERCASE(RGNEWSTREET)
       SET CITY TO UPPERCASE(RGNEWCITY)
       SET STATE TO UPPERCASE(RGNEWSTATE)
       SET ZIPCODE TO UPPERCASE(RGNEWZIPCODE)
      END
     CALL HANDLEFMERROR
    END
   ELSE IF NAMELEVELS(TMPLOOP)=NAMELEVELSHARE THEN
[* Add note when an error already occurred -- fm being skipped on this record
*]    
    DO
     ADDNOTETEXTADD=LEVELCHR+" Name LOC "+LOCATORCHR+" NOT UPDATED"
     CALL ADDNOTEADD
    END

   TMPLOOP=TMPLOOP+1
  END
END [PROCEDURE]

PROCEDURE NAMEFMBYIRS

 TMPLOOP=1
 WHILE TMPLOOP<=NAMECOUNT
  DO
   LEVELCHR=MATCHNAMELVLCHR(NAMELEVELS(TMPLOOP))
   BNONUM=NAMELOCATORS(TMPLOOP)
   CALL BNONUMTEXT
   LOCATORCHR=BNOTEXT

   IF NAMELEVELS(TMPLOOP)=NAMELEVELIRS AND
      BNOERRORCODE=BNOERRCODESUCCESS THEN
    DO
     FMPERFORM REVISE IRS LOC NAMEPATHLOCATORS(TMPLOOP) NAME LOC NAMELOCATORS(TMPLOOP)(0,0,FMERROR)
      DO
       SET EXTRAADDRESS TO UPPERCASE(RGNEWEXTRAADDR)
       SET STREET TO UPPERCASE(RGNEWSTREET)
       SET CITY TO UPPERCASE(RGNEWCITY)
       SET STATE TO UPPERCASE(RGNEWSTATE)
       SET ZIPCODE TO UPPERCASE(RGNEWZIPCODE)
      END
     CALL HANDLEFMERROR
    END
   ELSE IF NAMELEVELS(TMPLOOP)=NAMELEVELIRS THEN
[* Add note when an error already occurred -- fm being skipped on this record
*]    
    DO
     ADDNOTETEXTADD=LEVELCHR+" Name LOC "+LOCATORCHR+" NOT UPDATED"
     CALL ADDNOTEADD
    END

   TMPLOOP=TMPLOOP+1
  END
END [PROCEDURE]

