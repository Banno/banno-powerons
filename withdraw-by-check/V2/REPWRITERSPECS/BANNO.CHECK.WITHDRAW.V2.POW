**
**  --------------------------------------------------------------------
**  Program Summary
**  --------------------------------------------------------------------
**  [enter program summary information here]
**
**  --------------------------------------------------------------------
**  Program states and JSON returns
**  --------------------------------------------------------------------
**    STATE:  STATESTART
**  PROCESS:  Process STATESTART state and create json response
**     PASS:  @RGUSERCHR1 Account and share or loan ID (13 or 15 character string)
**            @RGUSERNUM1 n/a
**   RETURN:  Provides UX STATESTART response
**
**    STATE:  PERFORMWITHDRAW
**  PROCESS:  Process PERFORMWITHDRAW state and create json response
**     PASS:  @RGUSERCHR1 Account and share or loan ID (13 or 15 character string)
**            @RGUSERCHR2 Dollar amount of withdrwal
**            @RGUSERNUM1 n/a
**   RETURN:  Provides UX PERFORMWITHDRAW response
**
**  --------------------------------------------------------------------
**  Error codes and Logging Messages
**  --------------------------------------------------------------------
**  500: System in memo mode
**  501: Error reading/opening config file
**  502: Config file validation error
**  503: Avail. Balance <= $0.00
**  504: Invalid Address
**  505: Not Found
**  506: Reg D Limit
**  507: Cross Account WD Attempted
**  508: Amount requested out of bounds
**  509: Insufficient Funds
**  510: Unhandled Error
**  511: TRANPERFORM Other Error
**
**  --------------------------------------------------------------------
**  Additional Information
**  --------------------------------------------------------------------
**
**  --------------------------------------------------------------------
**  Modification History
** 
**    Ver. 2.0.0  07/20/2026 R. Robison: Original V2 version of Withdraw by Check PowerOn
**                           Feature set based on: BANNO.CHECK.WITHDRAW.V1.POW Ver. 1.2.1  06/07/2024
**                       
**    
*]
SYMCONNECT
STATELESS

TARGET=ACCOUNT

DEFINE
 #INCLUDE "RD.GETDATA.DEF"
 #INCLUDE "RB.LISTEXPAND.DEF"

 BNOLASTMODDATE            = '07/20/26'
 BNOLASTMODTIME            = "17:00 MT"
 BNOPROGRAMNAME            = "BANNO.CHECK.WITHDRAW.V2.POW"
 BNOCFGFILENAME            = "BANNO.CHECK.WITHDRAW.V2.CFG"
 BNOPROGRAMVERSION         = "2.0.0"
 BNOPROGRAMNOTE1           = "v2 with Spanish lang support"
 BNOPROGRAMNOTE2           = ""

 BNODEBUGPRINTINFODAYS     = 60
 BNODEBUGINCLUDEPARAMS     = 1

 STATESTART                = "STATESTART"
 STATEPERFORMWITHDRAW      = "PERFORMWITHDRAW"
 
[* Error code setup
*]
 BNOERRCODEMEMOMODE        = 500
 BNOERRCODECONFIGREAD      = 501
  BNOERRMODOPEN            = "[configuration file name] open error - [system generated letter file read error message]"
  BNOERRMODREAD            = "[configuration file name] read error - [system generated letter file read error message]"
 BNOERRCODECONFIGVALIDATE  = 502
  BNOERRMODDUPLICATEPARAM  = "Duplicate Param file entry([parameter name])"
  BNOERRMODINVALIDVALUE    = "Invalid Param Value([parameter name])"
 BNOERRCODESLAVAILBAL      = 503
 BNOERRCODEINVALIDADDR     = 504
 BNOERRCODENOTFOUND        = 505
  BNOERRMODACCTNOTFOUND    = "Account Not Found"
  BNOERRMODWARNFOUND       = "Account Warning Found: [3-digit comma separated account warning list]" 
  BNOERRMODSHARENOTFOUND   = "Share Not Found"
  BNOERRMODLOANNOTFOUND    = "Loan Not Found"
  BNOERRMODINVSHARETYPE    = "Invalid Share Type: [4-digit share type]"
  BNOERRMODINVLOANTYPE     = "Invalid Loan Type: [4-digit share type]"
  BNOERRMODSHAREWARN       = "Share Warning Found: [3-digit comma separated share warning list]"
  BNOERRMODLOANWARN        = "Loan Warning Found: [3-digit comma separated loan warning list]"
 BNOERRCODEREGD            = 506
  BNOERRMODREGD            = "[transaction posting system error message]"
 BNOERRCODECROSSACCT       = 507
 BNOERRCODEINVALIDAMT      = 508
 BNOERRCODENSF             = 509
  BNOERRMODNSFAMOUNTS      = "Amount req. [requested amount] exceeds avail. [available amount]"
  BNOERRMODNSF             = "[transaction posting system error message]"
 BNOERRUNHANDLED           = 510
 BNOERRCODETRANPERFOTHER   = 511
  BNOERRMODTRANPERFOTHER   = "[transaction posting system error message]"

[* RGUSER Pass variables - passed from UX code
*]
